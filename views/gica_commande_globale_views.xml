<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         VUE FORMULAIRE — Commande Globale (BCG)
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_gica_commande_globale_form" model="ir.ui.view">
        <field name="name">gica.commande.globale.form</field>
        <field name="model">gica.commande.globale</field>
        <field name="arch" type="xml">
            <form string="Bon de Commande Global">

                <!-- ── Barre d'actions ── -->
                <header>
                    <button name="action_demarrer"
                            string="Démarrer"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'nouveau'"/>
                    <button name="action_annuler"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('cloturee', 'annulee', 'expire')"/>
                    <button name="action_remettre_nouveau"
                            string="Remettre en Nouveau"
                            type="object"
                            invisible="state != 'annulee'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="nouveau,en_cours,cloturee,expire"/>
                </header>

                <sheet>
                    <!-- ── Smart buttons ── -->
                    <div class="oe_button_box" name="button_box">

                        <button class="oe_stat_button"
                                icon="fa-calendar"
                                type="object"
                                name="action_voir_planifications">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planification_count"/>
                                </span>
                                <span class="o_stat_text">Planifications</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-shopping-cart"
                                type="object"
                                name="action_voir_bons_commande"
                                invisible="bon_commande_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="bon_commande_count"/>
                                </span>
                                <span class="o_stat_text">Bons de commande</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-edit"
                                type="object"
                                name="action_voir_avenants"
                                invisible="avenant_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="avenant_count"/>
                                </span>
                                <span class="o_stat_text">Avenants</span>
                            </div>
                        </button>

                    </div>

                    <!-- ── Titre ── -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Informations principales ── -->
                    <group>
                        <group string="Informations">
                            <field name="client_id"
                                   string="Client"
                                   readonly="state != 'nouveau'"
                                   options="{'no_create': True}"/>
                            <field name="contrat_id"
                                   string="Contrat"
                                   readonly="state != 'nouveau'"
                                   options="{'no_create': True}"/>
                            <field name="date_commande"   string="Date de commande"/>
                            <field name="date_expiration" string="Date d'expiration"/>
                        </group>
                        <group string="Tarification">
                            <field name="pricelist_id"
                                   string="Liste de prix"
                                   options="{'no_create': True}"
                                   readonly="state != 'nouveau'"/>
                        </group>
                    </group>

                    <!-- ── Onglets ── -->
                    <notebook>

                        <!-- Onglet 1 : Produits -->
                        <page string="Produits commandés" name="produits">
                            <field name="line_ids" readonly="state in ('en_cours', 'cloturee', 'annulee', 'expire')">

                                <list editable="bottom">
                                    <field name="sequence"         widget="handle"/>
                                   <field name="product_tmpl_id"
                                        string="Produit"
                                        domain="[('is_gica_product', '=', True)]"/>

                                    <field name="conditionnement_id"
                                        string="Conditionnement"
                                        options="{'no_create': True, 'display_name_field': 'name'}"
                                        domain="[('pav_attribute_line_ids.product_tmpl_id', '=', product_tmpl_id),
                                                    ('attribute_id.name', '=', 'Conditionnement')]"/>

                                    <field name="quantity_tonne"  string="Qté totale (T)"   />
                                    <field name="prix_unitaire"   string="Prix unitaire (DA)"/>
                                    <field name="montant_total"      string="Montant (DA)"   readonly="1"/>
                                    <field name="quantity_planifiee" string="Planifiée (T)"  readonly="1"/>
                                    <field name="quantity_enlevee"   string="Enlevée (T)"    readonly="1"/>
                                    <field name="quantity_restante"  string="Restante (T)"   readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 2 : Planifications -->
                        <page string="Planifications" name="planifications">
                            <field name="planification_ids" nolabel="1">
                                <list decoration-success="state == 'validee'"
                                      decoration-warning="state == 'soumise'"
                                      decoration-danger="state == 'refusee'"
                                      decoration-muted="state == 'brouillon'">
                                    <field name="name"                 string="Référence"/>
                                    <field name="date_enlevement"      string="Date d'enlèvement"/>
                                    <field name="quantity_total_tonne" string="Qté (T)"/>
                                    <field name="source"               string="Source"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'validee'"
                                           decoration-warning="state == 'soumise'"
                                           decoration-danger="state == 'refusee'"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 3 : Bons de commande -->
                        <page string="Bons de commande" name="bons_commande">
                            <field name="bon_commande_ids" nolabel="1">
                                <list>
                                    <field name="name"                   string="Référence"/>
                                    <field name="date_prevue_enlevement" string="Date prévue"/>
                                    <field name="quantity_livree"        string="Qté livrée (T)"/>
                                    <field name="amount_total"           string="Montant (DA)"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 4 : Avenants -->
                        <page string="Avenants" name="avenants">
                            <field name="avenant_ids" nolabel="1">
                                <list decoration-success="state == 'valide'"
                                      decoration-warning="state == 'brouillon'">
                                    <field name="name"            string="N° Avenant"/>
                                    <field name="type_avenant"    string="Type" widget="badge"
                                           decoration-success="type_avenant == 'addition'"
                                           decoration-danger="type_avenant == 'reduction'"/>
                                    <field name="product_tmpl_id" string="Produit"/>
                                    <field name="conditionnement_id" string="Conditionnement"/>
                                    <field name="quantite"        string="Quantité (T)"/>
                                    <field name="ancien_prix"     string="Ancien prix (DA)"/>
                                    <field name="nouveau_prix"    string="Nouveau prix (DA)"/>
                                    <field name="date"            string="Date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'valide'"
                                           decoration-warning="state == 'brouillon'"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 5 : Observations -->
                        <page string="Observations" name="observations">
                            <field name="observations"
                                   placeholder="Notes, remarques, conditions particulières..."/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════
         VUE LISTE — Commandes Globales
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_gica_commande_globale_list" model="ir.ui.view">
        <field name="name">gica.commande.globale.list</field>
        <field name="model">gica.commande.globale</field>
        <field name="arch" type="xml">
            <list string="Commandes Globales"
                  decoration-success="state == 'cloturee'"
                  decoration-info="state == 'en_cours'"
                  decoration-muted="state in ('annulee', 'expire')">

                <field name="name"                 string="Référence"/>
                <field name="client_id"            string="Client"/>
                <field name="contrat_id"           string="Contrat"/>
                <field name="pricelist_id"         string="Liste de prix"/>
                <field name="date_commande"        string="Date commande"/>
                <field name="date_expiration"      string="Expiration"/>
                <field name="quantity_total_tonne" string="Qté totale (T)"/>
                <field name="quantity_planifiee"   string="Planifiée (T)"/>
                <field name="quantity_enlevee"     string="Enlevée (T)"/>
                <field name="quantity_restante"    string="Restante (T)"/>
                <field name="planification_count"  string="Planifs"/>
                <field name="bon_commande_count"   string="BC"/>
                <field name="avenant_count"        string="Avenants"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'cloturee'"
                       decoration-info="state == 'en_cours'"
                       decoration-warning="state == 'nouveau'"
                       decoration-danger="state == 'annulee'"
                       decoration-muted="state == 'expire'"/>
            </list>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════
         VUE RECHERCHE — Filtres et regroupements
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_gica_commande_globale_search" model="ir.ui.view">
        <field name="name">gica.commande.globale.search</field>
        <field name="model">gica.commande.globale</field>
        <field name="arch" type="xml">
            <search string="Rechercher une commande globale">

                <field name="name"         string="Référence"/>
                <field name="client_id"    string="Client"/>
                <field name="contrat_id"   string="Contrat"/>
                <field name="pricelist_id" string="Liste de prix"/>

                <separator/>

                <filter name="nouveau"  string="Nouveau"   domain="[('state', '=', 'nouveau')]"/>
                <filter name="en_cours" string="En cours"  domain="[('state', '=', 'en_cours')]"/>
                <filter name="cloturee" string="Clôturées" domain="[('state', '=', 'cloturee')]"/>
                <filter name="annulee"  string="Annulées"  domain="[('state', '=', 'annulee')]"/>
                <filter name="expire"   string="Expirées"  domain="[('state', '=', 'expire')]"/>

                <group expand="0" string="Regrouper par">
                    <filter name="group_client"    string="Client"        context="{'group_by': 'client_id'}"/>
                    <filter name="group_pricelist" string="Liste de prix" context="{'group_by': 'pricelist_id'}"/>
                    <filter name="group_state"     string="Statut"        context="{'group_by': 'state'}"/>
                    <filter name="group_date"      string="Mois"          context="{'group_by': 'date_commande:month'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════
         ACTION — Fenêtre principale BCG
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_gica_commande_globale" model="ir.actions.act_window">
        <field name="name">Commandes Globales</field>
        <field name="res_model">gica.commande.globale</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gica_commande_globale_search"/>
        <field name="context">{'search_default_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune commande globale enregistrée</p>
            <p>Créez une commande globale depuis un contrat client actif.</p>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clinker_approbation_wizard_form" model="ir.ui.view">
        <field name="name">clinker.approbation.wizard.form</field>
        <field name="model">clinker.approbation.wizard</field>
        <field name="arch" type="xml">
            <form string="Approbation Planning Clinker">
                <sheet>

                    <!-- Sélection date -->
                    <group string="Sélection de la Date">
                        <field name="date_approbation"/>
                        <button name="action_charger_planifications"
                                string="Charger les Planifications"
                                type="object"
                                class="btn-primary"/>
                    </group>

                    <!-- Cadence active -->
                    <group string="Cadence Active" invisible="not cadence_id">
                        <group>
                            <field name="cadence_id"       readonly="1"/>
                            <field name="cadence_quantite" readonly="1" string="Quantité (T/jour)"/>
                        </group>
                        <group>
                            <field name="cadence_min"      readonly="1" string="Min (T)"/>
                            <field name="cadence_max"      readonly="1" string="Max (T)"/>
                        </group>
                    </group>

                    <!-- Résumé -->
                    <group string="Résumé du jour" invisible="not line_ids">
                        <group>
                            <field name="total_demande"  readonly="1"/>
                            <field name="total_approuve" readonly="1"/>
                        </group>
                        <group>
                            <field name="taux_utilisation" readonly="1" string="Utilisation (%)"/>
                        </group>
                    </group>

                    <!-- Alerte 80% -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not alerte_80">
                        ⚠️ Attention — La consommation dépasse 80% de la cadence !
                    </div>

                    <!-- Lignes planifications -->
                    <field name="line_ids" invisible="not line_ids">
                        <list editable="bottom">
                            <field name="planning_id"       readonly="1"/>
                            <field name="client_id"         readonly="1"/>
                            <field name="estimation"        readonly="1" string="Estimation (T)"/>
                            <field name="quantite_approuvee" string="Qté Approuvée (T)"/>
                            <field name="action"            string="Action"/>
                            <field name="motif_refus"       string="Motif"
                                   invisible="action != 'refuser'"/>
                            <field name="dans_cadence"      readonly="1" widget="boolean"
                                   string="Dans Cadence"/>
                        </list>
                    </field>

                </sheet>
                <footer>
                    <button name="action_valider" string="Ok"
                            type="object" class="btn-primary"
                            invisible="not line_ids"/>
                    <button string="Annuler" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTION WIZARD -->
    <record id="action_clinker_approbation_wizard" model="ir.actions.act_window">
        <field name="name">Approbation Planning Clinker</field>
        <field name="res_model">clinker.approbation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
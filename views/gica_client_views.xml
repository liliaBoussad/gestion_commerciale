<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         LISTE — res.partner (clients GICA)
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_list" model="ir.ui.view">
        <field name="name">gica.client.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clients GICA">
                <field name="name"             string="Nom"/>
                <field name="client_type"      string="Type client"/>
                <field name="nature_client"    string="Nature"/>
                <field name="sale_type"        string="Type de vente"/>
                <field name="commercial_id"    string="Commercial"/>
                <field name="phone"            string="Téléphone"/>
                <field name="email"            string="E-mail"/>
                <field name="city"             string="Ville"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORMULAIRE — gica.client
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_form" model="ir.ui.view">
        <field name="name">gica.client.form</field>
        <field name="model">gica.client</field>
        <field name="arch" type="xml">
            <form string="Client GICA">
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du client"/></h1>
                    </div>

                    <group>
                        <group string="Informations client">
                            <field name="client_type"/>
                            <field name="nature_client"/>
                            <field name="sale_type"/>
                            <field name="commercial_id"/>
                        </group>
                        <group string="Coordonnées">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Onglet Projets -->
                        <page string="Projets" name="page_projets"
                              invisible="client_type != 'realisation'">
                            <field name="project_id" nolabel="1">
                                <list>
                                    <field name="name" string="Nom du projet"/>
                                </list>
                                <form>
                                    <sheet>
                                        <div class="oe_title">
                                            <label for="name"/>
                                            <h1><field name="name" placeholder="Nom du projet"/></h1>
                                        </div>
                                        <separator string="Produits du projet"/>
                                        <field name="line_ids" nolabel="1">
                                            <list editable="bottom">
                                                <field name="product_id"   string="Produit"/>
                                                <field name="quantity"     string="Quantité"/>
                                                <field name="unite_mesure" string="Unité"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         RECHERCHE — res.partner (clients GICA)
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_search" model="ir.ui.view">
        <field name="name">gica.client.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Rechercher un client">
                <field name="name"          string="Nom"/>
                <field name="commercial_id" string="Commercial"/>
                <field name="client_type"   string="Type client"/>
                <filter name="filter_morale"   string="Personne Morale"
                        domain="[('nature_client', '=', 'morale')]"/>
                <filter name="filter_physique" string="Personne Physique"
                        domain="[('nature_client', '=', 'physique')]"/>
                <separator/>
                <filter name="filter_comptant" string="Vente Comptant"
                        domain="[('sale_type', '=', 'comptant')]"/>
                <filter name="filter_terme"    string="Vente à Terme"
                        domain="[('sale_type', '=', 'terme')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type"       string="Type client"
                            context="{'group_by': 'client_type'}"/>
                    <filter name="group_nature"     string="Nature"
                            context="{'group_by': 'nature_client'}"/>
                    <filter name="group_commercial" string="Commercial"
                            context="{'group_by': 'commercial_id'}"/>
                    <filter name="group_sale_type"  string="Type de vente"
                            context="{'group_by': 'sale_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACTION — pointe vers res.partner filtré is_gica_client
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_gica_client" model="ir.actions.act_window">
        <field name="name">Clients GICA</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gica_client_list"/>
        <field name="search_view_id" ref="view_gica_client_search"/>
        <field name="domain">[('is_gica_client', '=', True)]</field>
        <field name="context">{'default_is_gica_client': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun client GICA enregistré
            </p>
            <p>Créez un contact et renseignez son type client pour l'identifier comme client GICA.</p>
        </field>
    </record>

</odoo>
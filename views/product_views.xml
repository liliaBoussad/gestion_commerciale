<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         Héritage product.template — ajout champs GICA
         ══════════════════════════════════════════════════════ -->
    <record id="view_product_template_gica_form" model="ir.ui.view">
        <field name="name">product.template.gica.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_gica_product" widget="boolean_toggle"/>
                <field name="type_ciment"
                       invisible="not is_gica_product"/>
              
            </xpath>
        </field>
    </record>

</odoo>
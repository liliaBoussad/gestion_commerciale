<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Production — avec Valider et Bloquer -->
    <record id="view_clinker_global_order_form" model="ir.ui.view">
        <field name="name">clinker.global.order.form</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <form string="Bon de Commande Global Clinker">
                <header>
                    <button name="action_soumettre"
                            string="Soumettre"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_activer"
                            string="Valider"
                            type="object"
                            class="btn-success"
                            invisible="state != 'soumis'"/>
                    <button name="action_bloquer"
                            string="Bloquer"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'soumis'"/>
                    <button name="action_resoumettre"
                            string="Re-soumettre"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'bloque'"/>
                    <button name="action_terminer"
                            string="Terminer"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'actif'"
                            confirm="Confirmer la cloture manuelle du BCG Clinker ?"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="brouillon,soumis,actif,termine"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-calendar"
                                type="object"
                                name="action_voir_planifications"
                                invisible="planning_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planning_count"/>
                                </span>
                                <span class="o_stat_text">Planifications</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                                icon="fa-shopping-cart"
                                type="object"
                                name="action_voir_bc_quotidiens"
                                invisible="bc_quotidien_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="bc_quotidien_count"/>
                                </span>
                                <span class="o_stat_text">BC Quotidiens</span>
                            </div>
                        </button>
                    </div>

                    <field name="expiration_proche" invisible="1"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'bloque'">
                        BCG bloque —
                        <field name="motif_refus" readonly="1" nolabel="1"/>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not expiration_proche">
                        Ce BCG Clinker expire le
                        <field name="date_expiration" readonly="1" nolabel="1"/>.
                        Pensez a renouveler avant expiration.
                    </div>

                    <group>
                        <group string="Client">
                            <field name="client_id"
                                   readonly="state != 'brouillon'"
                                   options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group string="Validite">
                            <field name="date_commande"
                                   readonly="state != 'brouillon'"/>
                            <field name="date_expiration"
                                   readonly="state != 'brouillon'"/>
                        </group>
                    </group>

                    <group string="Tarification">
                        <group>
                            <field name="pricelist_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'brouillon'"/>
                        </group>
                    </group>

                    <group string="Motif de blocage"
                           invisible="state not in ('bloque', 'soumis')">
                        <field name="motif_refus"
                               nolabel="1"
                               placeholder="Saisissez le motif avant de bloquer..."/>
                    </group>

                    <notebook>
                        <page string="Lignes de commande">
                            <field name="line_ids"
                                   readonly="state != 'brouillon'">
                                <list editable="bottom">
                                    <field name="sequence"        widget="handle"/>
                                    <field name="product_tmpl_id" string="Produit"
                                           domain="[('type_ciment', '=', 'clinker')]"/>
                                    <field name="product_id"      string="Variante"
                                           readonly="1" optional="hide"/>
                                    <field name="conditionnement_label" string="Conditionnement"
                                           readonly="1"/>
                                    <field name="quantite_autorisee" string="Qte autorisee (T)"/>
                                    <field name="prix_unitaire"      string="Prix unit. (DA)"/>
                                    <field name="montant_total"      string="Montant (DA)"
                                           readonly="1"/>
                                    <field name="quantite_livree"    string="Qte livree (T)"
                                           readonly="1"/>
                                    <field name="quantite_restante"  string="Qte restante (T)"
                                           readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="montant_total"
                                       string="Montant total (DA)"
                                       widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMULAIRE -->
    <record id="view_clinker_global_order_form" model="ir.ui.view">
        <field name="name">clinker.global.order.form</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <form string="Bon de Commande Global Clinker">
                <header>
                    <button name="action_soumettre" string="Soumettre"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_activer" string="✅ Valider"
                            type="object" class="btn-success"
                            invisible="state != 'soumis'"/>
                    <button name="action_bloquer" string="❌ Bloquer"
                            type="object" class="btn-danger"
                            invisible="state != 'soumis'"/>
                    <button name="action_resoumettre" string="↩️ Re-soumettre"
                            type="object" class="btn-warning"
                            invisible="state != 'bloque'"/>
                    <button name="action_terminer" string="🏁 Terminer"
                            type="object" class="btn-secondary"
                            invisible="state not in ('actif',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,soumis,actif,termine"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-calendar"
                                type="object" name="action_voir_planifications"
                                invisible="planning_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planning_count"/>
                                </span>
                                <span class="o_stat_text">Planifications</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group string="Informations Commerciales">
                        <group>
                            <field name="client_id"       readonly="state != 'brouillon'"/>
                            <field name="date_commande"   readonly="state != 'brouillon'"/>
                            <field name="date_expiration" readonly="state != 'brouillon'"/>
                        </group>
                        <group>
                            <field name="ref_bon_commande"/>
                            <field name="total_autorise" readonly="1"/>
                            <field name="total_livre"    readonly="1"/>
                            <field name="total_restant"  readonly="1"/>
                        </group>
                    </group>

                    <group string="Motif de refus/blocage"
                           invisible="state not in ('bloque',)">
                        <field name="motif_refus" nolabel="1"
                               placeholder="Saisissez le motif avant de bloquer..."/>
                    </group>

                    <notebook>
                        <page string="Lignes de Commande">
                            <field name="line_ids" readonly="state != 'brouillon'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantite_autorisee" string="Qté Autorisée (T)"/>
                                    <field name="quantite_livree"    string="Qté Livrée (T)"   readonly="1"/>
                                    <field name="quantite_restante"  string="Qté Restante (T)" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LISTE -->
    <record id="view_clinker_global_order_list" model="ir.ui.view">
        <field name="name">clinker.global.order.list</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <list string="BCG Clinker"
                  decoration-success="state == 'actif'"
                  decoration-info="state == 'soumis'"
                  decoration-danger="state == 'bloque'"
                  decoration-muted="state == 'termine'">
                <field name="name"            string="Référence"/>
                <field name="client_id"       string="Client"/>
                <field name="date_commande"   string="Date commande"/>
                <field name="date_expiration" string="Expiration"/>
                <field name="total_autorise"  string="Total (T)"/>
                <field name="total_restant"   string="Reste (T)"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'actif'"
                       decoration-info="state == 'soumis'"
                       decoration-danger="state == 'bloque'"
                       decoration-muted="state == 'termine'"/>
            </list>
        </field>
    </record>

    <!-- RECHERCHE -->
    <record id="view_clinker_global_order_search" model="ir.ui.view">
        <field name="name">clinker.global.order.search</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <search string="Rechercher un BCG Clinker">
                <field name="name"      string="Référence"/>
                <field name="client_id" string="Client"/>
                <separator/>
                <filter name="brouillon" string="Brouillon" domain="[('state','=','brouillon')]"/>
                <filter name="soumis"    string="Soumis"    domain="[('state','=','soumis')]"/>
                <filter name="actif"     string="Actifs"    domain="[('state','=','actif')]"/>
                <filter name="bloque"    string="Bloqués"   domain="[('state','=','bloque')]"/>
                <filter name="termine"   string="Terminés"  domain="[('state','=','termine')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client" string="Client"
                            context="{'group_by':'client_id'}"/>
                    <filter name="group_state"  string="Statut"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION VENTES -->
    <record id="action_clinker_global_order" model="ir.actions.act_window">
        <field name="name">BCG Clinker</field>
        <field name="res_model">clinker.global.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinker_global_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun BCG Clinker — créez-en un.</p>
        </field>
    </record>

    <!-- ACTION PRODUCTION (filtre soumis) -->
    <record id="action_clinker_global_order_production" model="ir.actions.act_window">
        <field name="name">BCG Clinker — Production</field>
        <field name="res_model">clinker.global.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','soumis')]</field>
        <field name="search_view_id" ref="view_clinker_global_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun BCG en attente de traitement.</p>
        </field>
    </record>

    <!-- ACTION COMMANDES CLINKER (BC-C) -->
    <record id="action_clinker_commandes" model="ir.actions.act_window">
        <field name="name">Commandes Clinker</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinker','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune commande clinker.</p>
        </field>
    </record>

</odoo>
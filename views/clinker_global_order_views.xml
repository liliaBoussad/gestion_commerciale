    <record id="view_clinker_global_order_list" model="ir.ui.view">
        <field name="name">clinker.global.order.list</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <list string="BCG Clinker"
                  decoration-success="state == 'actif'"
                  decoration-info="state == 'soumis'"
                  decoration-warning="expiration_proche == True"
                  decoration-danger="state == 'bloque'"
                  decoration-muted="state == 'termine'">
                <field name="name"              string="Reference"/>
                <field name="client_id"         string="Client"/>
                <field name="date_commande"     string="Date commande"/>
                <field name="date_expiration"   string="Expiration"/>
                <field name="pricelist_id"      string="Liste de prix"/>
                <field name="total_autorise"    string="Total (T)"/>
                <field name="total_livre"       string="Livre (T)"/>
                <field name="total_restant"     string="Reste (T)"/>
                <field name="montant_total"     string="Montant (DA)"/>
                <field name="planning_count"    string="Planifs"/>
                <field name="expiration_proche" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'actif'"
                       decoration-info="state == 'soumis'"
                       decoration-danger="state == 'bloque'"
                       decoration-muted="state == 'termine'"/>
            </list>
        </field>
    </record>

    <record id="view_clinker_global_order_search" model="ir.ui.view">
        <field name="name">clinker.global.order.search</field>
        <field name="model">clinker.global.order</field>
        <field name="arch" type="xml">
            <search string="Rechercher un BCG Clinker">
                <field name="name"         string="Reference"/>
                <field name="client_id"    string="Client"/>
                <field name="pricelist_id" string="Liste de prix"/>
                <separator/>
                <filter name="brouillon" string="Brouillon"
                        domain="[('state','=','brouillon')]"/>
                <filter name="soumis"    string="Soumis"
                        domain="[('state','=','soumis')]"/>
                <filter name="actif"     string="Actifs"
                        domain="[('state','=','actif')]"/>
                <filter name="bloque"    string="Bloques"
                        domain="[('state','=','bloque')]"/>
                <filter name="termine"   string="Termines"
                        domain="[('state','=','termine')]"/>
                <filter name="expiration_proche" string="Expiration proche"
                        domain="[('expiration_proche','=',True)]"/>
                <separator/>
                <filter name="en_cours"  string="En cours"
                        domain="[('state', 'in', ['soumis', 'actif'])]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client"    string="Client"
                            context="{'group_by': 'client_id'}"/>
                    <filter name="group_pricelist" string="Liste de prix"
                            context="{'group_by': 'pricelist_id'}"/>
                    <filter name="group_state"     string="Statut"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date"      string="Mois"
                            context="{'group_by': 'date_commande:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Commercial — vue sans Valider/Bloquer -->
    <record id="action_clinker_global_order" model="ir.actions.act_window">
        <field name="name">BCG Clinker</field>
        <field name="res_model">clinker.global.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinker_global_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinker_global_order_form_commercial')})]"/>
        <field name="search_view_id" ref="view_clinker_global_order_search"/>
        <field name="context">{'search_default_actif': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun BCG Clinker enregistre</p>
            <p>Creez un BCG Clinker pour un client GICA.</p>
        </field>
    </record>

    <!-- Action Production — vue avec Valider/Bloquer -->
    <record id="action_clinker_global_order_production" model="ir.actions.act_window">
        <field name="name">BCG Clinker — Production</field>
        <field name="res_model">clinker.global.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinker_global_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinker_global_order_form')})]"/>
        <field name="domain">[('state', '=', 'soumis')]</field>
        <field name="search_view_id" ref="view_clinker_global_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun BCG en attente de traitement.</p>
        </field>
    </record>

    <record id="action_clinker_commandes" model="ir.actions.act_window">
        <field name="name">Commandes Clinker</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinker', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune commande clinker.</p>
        </field>
    </record>

</odoo>
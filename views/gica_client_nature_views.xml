<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORMULAIRE
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_nature_form" model="ir.ui.view">
        <field name="name">gica.client.nature.form</field>
        <field name="model">gica.client.nature</field>
        <field name="arch" type="xml">
            <form string="Nature des clients">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="type_nature"/>
                        </group>
                        <group string="Documents à fournir">
                            <field name="document_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Champs Requis">
                        <group>
                            <field name="nis_obligatoire"/>
                            <field name="nif_obligatoire"/>
                            <field name="ai_obligatoire"/>
                            <field name="rc_obligatoire"/>
                        </group>
                        <group>
                            <field name="nin_obligatoire"/>
                            <field name="rib_obligatoire"/>
                            <field name="swift_obligatoire"/>
                        </group>
                    </group>
                    <group>
                        <field name="est_filiale_gica"/>
                        <field name="est_don_charite"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         LISTE
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_nature_list" model="ir.ui.view">
        <field name="name">gica.client.nature.list</field>
        <field name="model">gica.client.nature</field>
        <field name="arch" type="xml">
            <list string="Natures des clients">
                <field name="complete_name"  string="Nom complet"/>
                <field name="document_ids"   string="Documents à fournir" widget="many2many_tags"/>
                <field name="type_nature"    string="Type" widget="badge"
                       decoration-info="type_nature == 'utilise'"
                       decoration-warning="type_nature == 'vue'"/>
                <field name="est_filiale_gica" string="Filiale GICA"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         RECHERCHE
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_client_nature_search" model="ir.ui.view">
        <field name="name">gica.client.nature.search</field>
        <field name="model">gica.client.nature</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="name" string="Nom"/>
                <separator/>
                <filter name="filter_utilise" string="Utilisé"
                        domain="[('type_nature', '=', 'utilise')]"/>
                <filter name="filter_vue" string="Vue"
                        domain="[('type_nature', '=', 'vue')]"/>
                <separator/>
                <filter name="filter_archive" string="Archivés"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_parent" string="Nature parente"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACTION
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_gica_client_nature" model="ir.actions.act_window">
        <field name="name">Nature des clients</field>
        <field name="res_model">gica.client.nature</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gica_client_nature_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune nature configurée
            </p>
            <p>Créez les natures de clients (Personne Morale, Physique, etc.).</p>
        </field>
    </record>

</odoo>
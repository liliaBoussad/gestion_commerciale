<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         Formulaire Planification Usine
    ══════════════════════════════════════════════════ -->
    <record id="view_gica_planification_usine_form" model="ir.ui.view">
        <field name="name">gica.planification.usine.form</field>
        <field name="model">gica.planification.usine</field>
        <field name="arch" type="xml">
            <form string="Planification Usine">
                <header>
                    <button name="action_recuperer_planifications"
                            string="Récupérer Planifications"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_calculer_consolidation"
                            string="📊 Recalculer Consolidation"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <button name="action_confirmer"
                            string="✅ Confirmer et Verrouiller"
                            type="object"
                            class="btn-success"
                            invisible="state != 'en_cours'"/>
                    <button name="action_remettre_en_cours"
                            string="↩️ Remettre en cours"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'confirmee'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,en_cours,confirmee"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-list"
                                type="object"
                                name="action_voir_planifications">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planification_count"/>
                                </span>
                                <span class="o_stat_text">Total</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                                icon="fa-check"
                                type="object"
                                name="action_voir_planifications">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planification_validee_count"/>
                                </span>
                                <span class="o_stat_text">Validées</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                                icon="fa-clock-o"
                                type="object"
                                name="action_voir_planifications">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planification_en_attente_count"/>
                                </span>
                                <span class="o_stat_text">En attente</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                                icon="fa-times"
                                type="object"
                                name="action_voir_planifications">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="planification_refusee_count"/>
                                </span>
                                <span class="o_stat_text">Refusées</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Période (15 jours)">
                            <field name="date_debut"/>
                            <field name="date_fin" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Onglet 1 : Détail par ligne -->
                        <page string="Détail par ligne" name="detail">
                            <field name="planification_line_ids" readonly="1">
                                <list decoration-success="state == 'validee'"
                                      decoration-danger="state == 'refusee'"
                                      decoration-warning="state == 'en_attente'">
                                    <field name="state" widget="badge"
                                           string="État"
                                           decoration-success="state == 'validee'"
                                           decoration-danger="state == 'refusee'"
                                           decoration-warning="state == 'en_attente'"/>
                                    <field name="date_enlevement"    string="Date enlèvement"/>
                                    <field name="client_id"          string="Client"/>
                                    <field name="commande_globale_id" string="BCG"/>
                                    <field name="product_id"         string="Produit"/>
                                    <!-- conditionnement_id : Many2one (refactoring Selection → Many2one) -->
                                    <field name="conditionnement_id"
                                            string="Conditionnement"
                                            options="{'no_create': True, 'display_name_field': 'name'}"
                                            domain="[('pav_attribute_line_ids.product_tmpl_id', '=', product_tmpl_id),
                                                        ('attribute_id.name', '=', 'Conditionnement')]"/>
                                    <field name="nbr_paquets"        string="Qté paquets"/>
                                    <field name="rotation"           string="Rotations"/>
                                    <field name="quantity_tonne"     string="Quantité (T)" sum="Total (T)"/>
                                    <field name="quantity_disponible" string="Qté restante BCG"/>
                                    <button name="action_valider_ligne"
                                            string="✅ Valider"
                                            type="object"
                                            class="btn-success btn-sm"
                                            invisible="state != 'en_attente'"/>
                                    <button name="action_refuser_ligne"
                                            string="❌ Refuser"
                                            type="object"
                                            class="btn-danger btn-sm"
                                            invisible="state != 'en_attente'"/>
                                    <button name="action_voir_bc"
                                            string="🔍 Voir"
                                            type="object"
                                            class="btn-secondary btn-sm"
                                            invisible="not sale_order_id"/>
                                    <field name="motif_refus"
                                            string="Motif refus"
                                            optional="show"
                                            readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 2 : Consolidation -->
                        <!--
                            consolidation_ids appartient à gica.planification.usine.
                            Le champ 'conditionnement' ici est un Char calculé sur ce modèle
                            → pas à modifier.
                        -->
                        <page string="📊 Consolidation"
                              name="consolidation"
                              invisible="state == 'brouillon'">
                            <field name="consolidation_ids" readonly="1">
                                <list default_group_by="date_enlevement">
                                    <field name="date_enlevement" string="Date enlèvement"/>
                                    <field name="product_id"      string="Produit"/>
                                    <field name="conditionnement" string="Conditionnement"/>
                                    <field name="nb_lignes"       string="Nb planification" sum="Total clients"/>
                                    <field name="nb_rotations"    string="Rotations"        sum="Total rotations"/>
                                    <field name="quantity_tonne"  string="Qté totale (T)"   sum="Total (T)"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 3 : Observations -->
                        <page string="Observations" name="observations">
                            <field name="observations"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════
         Vue Liste
    ══════════════════════════════════════════════════ -->
    <record id="view_gica_planification_usine_list" model="ir.ui.view">
        <field name="name">gica.planification.usine.list</field>
        <field name="model">gica.planification.usine</field>
        <field name="arch" type="xml">
            <list string="Planifications Usine"
                  decoration-success="state == 'confirmee'"
                  decoration-info="state == 'en_cours'"
                  decoration-muted="state == 'brouillon'">
                <field name="name"                          string="Référence"/>
                <field name="date_debut"                    string="Début"/>
                <field name="date_fin"                      string="Fin"/>
                <field name="planification_count"           string="Total"/>
                <field name="planification_en_attente_count" string="En attente"/>
                <field name="planification_validee_count"   string="Validées"/>
                <field name="planification_refusee_count"   string="Refusées"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmee'"
                       decoration-info="state == 'en_cours'"/>
            </list>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════
         Vue Recherche
    ══════════════════════════════════════════════════ -->
    <record id="view_gica_planification_usine_search" model="ir.ui.view">
        <field name="name">gica.planification.usine.search</field>
        <field name="model">gica.planification.usine</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="name"/>
                <filter string="Brouillon" name="brouillon" domain="[('state', '=', 'brouillon')]"/>
                <filter string="En cours"  name="en_cours"  domain="[('state', '=', 'en_cours')]"/>
                <filter string="Confirmée" name="confirmee" domain="[('state', '=', 'confirmee')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('date_debut', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════
         Action
    ══════════════════════════════════════════════════ -->
    <record id="action_gica_planification_usine" model="ir.actions.act_window">
        <field name="name">Planifications Usine</field>
        <field name="res_model">gica.planification.usine</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune planification usine</p>
            <p>Créez une planification usine pour valider les demandes clients sur une période de 15 jours.</p>
        </field>
    </record>

</odoo>
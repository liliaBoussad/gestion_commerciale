<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste -->
    <record id="view_gica_client_contract_list" model="ir.ui.view">
        <field name="name">gica.client.contract.list</field>
        <field name="model">gica.client.contract</field>
        <field name="arch" type="xml">
            <list string="Contrats"
                  decoration-success="state == 'en_cours'"
                  decoration-info="state == 'actif'"
                  decoration-warning="state == 'suspendu'"
                  decoration-muted="state in ('expire','resilie')"
                  decoration-primary="state == 'draft'">
                <field name="name"       string="N° Contrat"/>
                <field name="client_id"  string="Client"/>
                <field name="project_id" string="Projet" optional="show"/>
                <field name="date_start" string="Date début"/>
                <field name="date_end"   string="Date fin"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'en_cours'"
                       decoration-info="state == 'actif'"
                       decoration-warning="state == 'suspendu'"
                       decoration-danger="state == 'resilie'"
                       decoration-muted="state == 'expire'"/>
            </list>
        </field>
    </record>

    <!-- Formulaire -->
    <record id="view_gica_client_contract_form" model="ir.ui.view">
        <field name="name">gica.client.contract.form</field>
        <field name="model">gica.client.contract</field>
        <field name="arch" type="xml">
            <form string="Contrat Client GICA">
                <header>
                    <button name="action_activer"   string="Activer"   type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_demarrer"  string="Démarrer"  type="object" class="btn-primary"
                            invisible="state != 'actif'"/>
                    <button name="action_suspendre" string="Suspendre" type="object" class="btn-warning"
                            invisible="state not in ('actif','en_cours')"/>
                    <button name="action_resilier"  string="Résilier"  type="object" class="btn-danger"
                            invisible="state in ('resilie','expire','draft')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,actif,en_cours,expire"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- client_type invisible — utilisé pour l'invisible du projet -->
                    <field name="client_type" invisible="1"/>

                    <group string="Informations">
                        <group>
                            <field name="client_id"
                                   readonly="state != 'draft'"/>
                            <field name="project_id"
                                   invisible="client_type != 'realisation'"
                                   readonly="state != 'draft'"
                                   domain="[('client_id', '=', client_id)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end"   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Modalités de paiement">
                        <group>
                            <field name="mode_paiement"/>
                            <field name="modalite_paiement"/>
                        </group>
                        <group>
                            <field name="delai_paiement"/>
                            <field name="delai_livraison"/>
                            <field name="lieu_livraison"/>
                            <field name="adresse_livraison"
                                   invisible="lieu_livraison != 'livraison_site'"/>
                        </group>
                    </group>

                    <group string="Motif"
                           invisible="state not in ('suspendu','resilie')">
                        <field name="motif_suspension" nolabel="1"
                               placeholder="Saisissez le motif..."/>
                    </group>

                    <notebook>
                        <page string="Produits commandés">
                            <field name="line_ids" readonly="state in ('expire','resilie')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           domain="[('product_tmpl_id.is_gica_product','=',True)]"/>
                                    <field name="quantity"       string="Quantité"/>
                                    <field name="uom"            string="Unité"/>
                                    <field name="quantity_tonne" string="Qté (T)" readonly="1"/>
                                    <field name="prix_unitaire"  string="Prix (DA)"/>
                                    <field name="montant_total"  string="Total (DA)" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="quantity_total_tonne" string="Total (T)"  readonly="1"/>
                                <field name="montant_total"        string="Total (DA)" readonly="1"/>
                            </group>
                        </page>
                        <page string="Observations">
                            <field name="observations"
                                   placeholder="Notes, clauses particulières..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Recherche -->
    <record id="view_gica_client_contract_search" model="ir.ui.view">
        <field name="name">gica.client.contract.search</field>
        <field name="model">gica.client.contract</field>
        <field name="arch" type="xml">
            <search string="Rechercher un contrat">
                <field name="name"       string="N° Contrat"/>
                <field name="client_id"  string="Client"/>
                <field name="project_id" string="Projet"/>
                <field name="line_ids"   string="Produit"/>
                <separator/>
                <filter name="actif"    string="Actifs"    domain="[('state','=','actif')]"/>
                <filter name="en_cours" string="En cours"  domain="[('state','=','en_cours')]"/>
                <filter name="suspendu" string="Suspendus" domain="[('state','=','suspendu')]"/>
                <filter name="expire"   string="Expirés"   domain="[('state','=','expire')]"/>
                <filter name="resilie"  string="Résiliés"  domain="[('state','=','resilie')]"/>
                <separator/>
                <filter name="beton"   string="GICA BÉTON"
                        domain="[('line_ids.type_ciment','in',['cem_ii_325','cem_ii_425_n','cem_ii_425_r'])]"/>
                <filter name="moudhad" string="GICA MOUDHAD"
                        domain="[('line_ids.type_ciment','in',['cem_i_425_crs','cem_i_525'])]"/>
                <filter name="petrole" string="GICA PÉTROLE"
                        domain="[('line_ids.type_ciment','=','well_cement_g')]"/>
                <filter name="clinker" string="Clinker"
                        domain="[('line_ids.type_ciment','=','clinker')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client"  string="Client"
                            context="{'group_by':'client_id'}"/>
                    <filter name="group_project" string="Projet"
                            context="{'group_by':'project_id'}"/>
                    <filter name="group_state"   string="Statut"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gica_client_contract" model="ir.actions.act_window">
        <field name="name">Contrats</field>
        <field name="res_model">gica.client.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gica_client_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un nouveau contrat</p>
            <p>Gérez ici les contrats commerciaux avec vos clients GICA.</p>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         FORMULAIRE — gica.project
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_project_form" model="ir.ui.view">
        <field name="name">gica.project.form</field>
        <field name="model">gica.project</field>
        <field name="arch" type="xml">
            <form string="Projet">
                <header>
                    <button name="action_demarrer"  string="Démarrer"  type="object"
                            class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_terminer"  string="Terminer"  type="object"
                            class="btn-success"
                            invisible="state != 'en_cours'"/>
                    <button name="action_annuler"   string="Annuler"   type="object"
                            class="btn-danger"
                            invisible="state in ('termine','annule')"/>
                    <button name="action_brouillon" string="Remettre en brouillon" type="object"
                            class="btn-secondary"
                            invisible="state not in ('annule','termine')"/>
                    <button name="action_creer_contrat" string="Créer un contrat"
                            type="object" class="btn-primary"
                            invisible="state != 'en_cours' or contract_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,en_cours,termine"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_contrats" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="contract_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="contract_count"/>
                                </span>
                                <span class="o_stat_text">Contrat(s)</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h4 style="color: #875A7B;">
                            <field name="reference" readonly="1"/>
                        </h4>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du projet"/></h1>
                        
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="client_ref" readonly="1" string="Code client"/>
                            <field name="client_id"
                                domain="[('client_type','=','realisation')]"
                                options="{'no_create': True}"/>
                        </group>
                       
                    </group>

                    <notebook>
                        <page string="Produits du projet">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence"         widget="handle"/>
                                    <field name="product_id"       string="Produit"
                                           domain="[('product_tmpl_id.is_gica_product','=',True)]"/>
                                    <field name="quantity"         string="Quantité"/>
                                    <field name="unite_mesure"     string="Unité"/>
                                    <field name="quantity_livree"  string="Livré"/>
                                    <field name="quantity_restante" string="Restant" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="nb_produits"    string="Nb produits"/>
                                <field name="quantity_total" string="Quantité totale"/>
                            </group>
                        </page>
                        <page string="Observations">
                            <field name="observations"
                                   placeholder="Notes, informations complémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         LISTE — gica.project
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_project_list" model="ir.ui.view">
        <field name="name">gica.project.list</field>
        <field name="model">gica.project</field>
        <field name="arch" type="xml">
            <list string="Projets"
                  decoration-success="state == 'en_cours'"
                  decoration-muted="state in ('termine','annule')"
                  decoration-info="state == 'brouillon'">
                <field name="reference"     string="Référence"    optional="show"/>
                <field name="name"          string="Nom du projet"/>
                <field name="client_id"     string="Client"/>
        
                
                <field name="state"         string="Statut"       widget="badge"
                       decoration-success="state == 'en_cours'"
                       decoration-info="state == 'brouillon'"
                       decoration-muted="state == 'termine'"
                       decoration-danger="state == 'annule'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         RECHERCHE — gica.project
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_gica_project_search" model="ir.ui.view">
        <field name="name">gica.project.search</field>
        <field name="model">gica.project</field>
        <field name="arch" type="xml">
            <search string="Rechercher un projet">
                <field name="name"      string="Nom du projet"/>
                <field name="reference" string="Référence"/>
                <field name="client_ref"    string="Code client"/>

                <field name="client_id" string="Client"/>
                <field name="wilaya"    string="Wilaya"/>
                <separator/>
                <filter name="brouillon" string="Brouillon"
                        domain="[('state','=','brouillon')]"/>
                <filter name="en_cours"  string="En cours"
                        domain="[('state','=','en_cours')]"/>
                <filter name="termine"   string="Terminés"
                        domain="[('state','=','termine')]"/>
                <filter name="annule"    string="Annulés"
                        domain="[('state','=','annule')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client" string="Client"
                            context="{'group_by':'client_id'}"/>
                    <filter name="group_state"  string="Statut"
                            context="{'group_by':'state'}"/>
                    <filter name="group_wilaya" string="Wilaya"
                            context="{'group_by':'wilaya'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         ACTION — gica.project
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_gica_project" model="ir.actions.act_window">
        <field name="name">Projets</field>
        <field name="res_model">gica.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gica_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun projet</p>
            <p>Créez un projet depuis la fiche d'un client Entreprise de Réalisation.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         ONGLET PROJETS dans res.partner (ER uniquement)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_partner_gica_project_tab" model="ir.ui.view">
        <field name="name">res.partner.gica.project.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_partner_gica_form"/>
        <field name="arch" type="xml">
            <page name="page_fiscal" position="after">
                <page string="Projets" name="page_projets"
                      invisible="client_type != 'realisation'">

                    <!-- Alerte si pas de projet -->
                    <div class="alert alert-warning" role="alert"
                         invisible="project_count != 0">
                        ⚠️ Ce client n'a aucun projet enregistré.
                        Un projet est obligatoire avant de créer un contrat.
                        <button name="action_creer_projet" type="object"
                                string="+ Créer un projet"
                                class="btn btn-warning btn-sm ms-3"
                                icon="fa-plus"/>
                    </div>

                    <field name="project_ids" nolabel="1"
                           context="{'default_client_id': id}">
                        <list create="0"
                              decoration-success="state == 'en_cours'"
                              decoration-muted="state in ('termine','annule')">
                            <field name="reference"      string="Référence"/>
                            <field name="name"           string="Nom du projet"/>
                            <field name="date_debut"     string="Début"/>
                            <field name="date_fin"       string="Fin"/>
                            <field name="nb_produits"    string="Produits"/>
                            <field name="contract_count" string="Contrats"/>
                            <field name="state"          widget="badge"
                                   decoration-success="state == 'en_cours'"
                                   decoration-info="state == 'brouillon'"
                                   decoration-muted="state == 'termine'"
                                   decoration-danger="state == 'annule'"/>
                        </list>
                    </field>

                    <div style="margin-top: 12px;">
                        <button name="action_creer_projet" type="object"
                                string="+ Nouveau projet"
                                class="btn-primary btn-sm" icon="fa-plus"/>
                    </div>
                </page>
            </page>
        </field>
    </record>

</odoo>
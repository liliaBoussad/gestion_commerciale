<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des planifications -->
    <template id="portail_gica_planifications" name="Portail GICA Planifications">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes Planifications</t>
            </t>
            <div class="container mt-4">

                <t t-set="erreur" t-value="request.params.get('erreur')"/>
                <t t-set="succes" t-value="request.params.get('succes')"/>
                <t t-set="ref"    t-value="request.params.get('ref')"/>

                <t t-if="succes == 'planif_soumise' and ref">
                   <t t-set="planif_ref" t-value="planifications.filtered(lambda p: p.name == ref)"/>
                    <t t-if="planif_ref and planif_ref[0].state == 'soumise'">
                        <div class="alert alert-success">
                            Votre planification <strong><t t-esc="ref"/></strong> a ete soumise.
                            Elle sera traitee par votre commercial.
                        </div>
                    </t>
                    <t t-elif="planif_ref and planif_ref[0].state == 'validee'">
                        <div class="alert alert-info">
                            Votre planification <strong><t t-esc="ref"/></strong> a ete validee .
                        </div>
                    </t>
                    <t t-elif="planif_ref and planif_ref[0].state == 'refusee'">
                        <div class="alert alert-danger">
                            Votre planification <strong><t t-esc="ref"/></strong> a ete refusee .
                        </div>
                    </t>
                </t>


                <t t-if="erreur == 'aucun_bcg'">
                    <div class="alert alert-warning">
                        Aucun BCG en cours disponible pour planifier. Contactez votre commercial.
                    </div>
                </t>
                <t t-if="erreur == 'bcg_invalide'">
                    <div class="alert alert-danger">BCG invalide ou non autorise.</div>
                </t>

                <t t-if="peut_planifier">
                    <a href="/my/gica/planifications/nouveau" class="btn btn-primary mb-3">
                        <i class="fa fa-plus"/> Nouvelle Planification
                    </a>
                </t>
                <t t-else="">
                    <div class="alert alert-info mb-3">
                        Aucun BCG en cours disponible pour planifier.
                    </div>
                </t>

                <t t-if="not planifications">
                    <div class="alert alert-info">Aucune planification pour le moment.</div>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Reference</th>
                                    <th>BCG</th>
                                    <th>Date enlevement</th>
                                    <th>Qte totale (T)</th>
                                    <th>Statut</th>
                                    <th>Action</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="planifications" t-as="planif">
                                    <tr>
                                        <td><strong><t t-esc="planif.name"/></strong></td>
                                        <td><t t-esc="planif.commande_globale_id.name"/></td>
                                        <td><t t-esc="planif.date_enlevement"/></td>
                                        <td><t t-esc="'%.2f' % planif.quantity_total_tonne"/></td>
                                        <td>
                                            <t t-if="planif.state == 'brouillon'">
                                                <span class="badge bg-secondary">Brouillon</span>
                                            </t>
                                            <t t-elif="planif.state == 'soumise'">
                                                <span class="badge bg-warning text-dark">En attente validation</span>
                                            </t>
                                            <t t-elif="planif.state == 'validee'">
                                                <span class="badge bg-success">Validee</span>
                                            </t>
                                            <t t-elif="planif.state == 'refusee'">
                                                <span class="badge bg-danger">Refusee</span>
                                            </t>
                                        </td>
                                     
                                      
                                        <td>
                                            <a t-att-href="'/my/gica/planifications/%d' % planif.id"
                                            class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-eye"/> Voir
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Formulaire nouvelle planification -->
    <template id="portail_gica_planification_form" name="Portail GICA Nouvelle Planification">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Nouvelle Planification</t>
            </t>

            <div class="container mt-4">

                <t t-set="erreur" t-value="request.params.get('erreur')"/>
                <t t-if="erreur == 'lignes_vides'">
                    <div class="alert alert-danger">
                        Veuillez ajouter au moins une ligne avec produit, conditionnement, date et quantite.
                    </div>
                </t>
                <t t-if="erreur == 'bcg_manquant'">
                    <div class="alert alert-danger">Veuillez selectionner un BCG.</div>
                </t>
                <t t-if="erreur == 'validation'">
                    <div class="alert alert-danger">
                        Erreur de validation : verifiez les quantites et les dates.
                    </div>
                </t>

                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fa fa-calendar"/> Nouvelle Planification
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/my/gica/planifications/soumettre" id="form_planif">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <!-- Choix BCG -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    BCG <span class="text-danger">*</span>
                                </label>
                                <select name="bcg_id" id="select_bcg"
                                        class="form-select" required="1"
                                        style="pointer-events:auto;">
                                    <option value="">-- Selectionner un BCG --</option>
                                    <t t-foreach="bcgs_disponibles" t-as="bcg">
                                        <option t-att-value="bcg.id"
                                                t-att-selected="bcg_selectionne and bcg_selectionne.id == bcg.id">
                                            <t t-esc="bcg.name"/> - Restant :
                                            <t t-esc="'%.2f' % bcg.quantity_restante"/> T
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Info BCG -->
                            <div id="info_bcg" class="alert alert-light border mb-4"
                                 t-att-style="'' if bcg_selectionne else 'display:none;'">
                                <strong>Expiration BCG :</strong>
                                <span id="lbl_date_expiration">
                                    <t t-if="bcg_selectionne">
                                        <t t-esc="bcg_selectionne.date_expiration"/>
                                    </t>
                                </span>
                            </div>

                            <!-- Lignes planification -->
                            <div id="section_lignes"
                                 t-att-style="'' if bcg_selectionne else 'display:none;'">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0">
                                        <i class="fa fa-list"/> Lignes a planifier
                                    </h6>
                                    <button type="button" class="btn btn-sm btn-success"
                                            id="btn_ajouter_ligne"
                                            style="pointer-events:auto;">
                                        <i class="fa fa-plus"/> Ajouter une ligne
                                    </button>
                                </div>

                                <div class="alert alert-info small mb-3">
                                    <i class="fa fa-info-circle"/>
                                    La quantite ne peut pas depasser la quantite restante du BCG pour ce produit.
                                    Les jours vendredi et samedi ne sont pas autorises.
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-bordered" id="table_lignes">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Produit <span class="text-danger">*</span></th>
                                                <th>Conditionnement <span class="text-danger">*</span></th>
                                                <th>Date enlevement <span class="text-danger">*</span></th>
                                                <th>Qte (T) <span class="text-danger">*</span></th>
                                                <th>Rotations <span class="text-danger">*</span></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbody_lignes">
                                            <t t-if="bcg_selectionne and lignes_bcg">
                                                <tr class="ligne-planif" data-index="0">
                                                    <td>
                                                        <select name="product_0"
                                                                class="form-select form-select-sm select-product"
                                                                required="1"
                                                                style="pointer-events:auto;"
                                                                data-index="0">
                                                            <option value="">-- Choisir --</option>
                                                            <t t-foreach="lignes_bcg" t-as="ligne">
                                                                <option t-att-value="ligne['product_tmpl_id']"
                                                                        t-att-data-max="ligne['quantity_restante']"
                                                                        t-att-data-conds="ligne['conditionnements_json']">
                                                                    <t t-esc="ligne['product_name']"/>
                                                                    (max <t t-esc="'%.2f' % ligne['quantity_restante']"/> T)
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select name="cond_0"
                                                                class="form-select form-select-sm select-cond"
                                                                required="1"
                                                                style="pointer-events:auto;"
                                                                data-index="0">
                                                            <option value="">-- Choisir --</option>
                                                            <t t-if="lignes_bcg">
                                                                <t t-foreach="lignes_bcg[0]['conditionnements']" t-as="cond">
                                                                    <option t-att-value="cond['id']">
                                                                        <t t-esc="cond['name']"/>
                                                                    </option>
                                                                </t>
                                                            </t>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="date" name="date_0"
                                                               class="form-control form-control-sm"
                                                               style="pointer-events:auto;"
                                                               required="1"/>
                                                    </td>
                                                    <t t-if="erreur == 'date_weekend'">
                                                            <div class="alert alert-danger">
                                                                La date choisie est un vendredi ou samedi. Veuillez choisir un jour ouvrable.
                                                            </div>
                                                    </t>
                                                        <t t-if="erreur == 'date_verrouillee'">
                                                            <div class="alert alert-danger">
                                                                La date choisie est dans une periode verrouillee. Veuillez choisir une autre date.
                                                            </div>
                                                        </t>
                                                        <td>
                                                             <input type="number" name="qty_0"
                                                               step="0.01" min="0.01"
                                                               class="form-control form-control-sm input-qty"
                                                               style="pointer-events:auto;"
                                                               data-index="0"
                                                               required="1"/>
                                                        </td>
                                                        <td>
                                                           <input type="number" name="rotation_0"
                                                               min="1" value="1"
                                                               class="form-control form-control-sm"
                                                               style="pointer-events:auto;"
                                                               required="1"/>
                                                        </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger btn-suppr"
                                                                style="pointer-events:auto;">
                                                            <i class="fa fa-trash"/>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Observations -->
                            <div class="mb-4" id="section_observations"
                                 t-att-style="'' if bcg_selectionne else 'display:none;'">
                                <label class="form-label fw-bold">Observations</label>
                                <textarea name="observations" class="form-control" rows="3"
                                          style="pointer-events:auto;"/>
                            </div>

                            <!-- Boutons -->
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" id="btn_soumettre"
                                        t-att-disabled="None if bcg_selectionne else 'disabled'">
                                    <i class="fa fa-paper-plane"/> Soumettre la planification
                                </button>
                                <a href="/my/gica/planifications" class="btn btn-secondary">Annuler</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
            //<![CDATA[
            document.addEventListener('DOMContentLoaded', function () {
                var selectBcg     = document.getElementById('select_bcg');
                var infoBcg       = document.getElementById('info_bcg');
                var sectionLignes = document.getElementById('section_lignes');
                var sectionObs    = document.getElementById('section_observations');
                var btnSoumettre  = document.getElementById('btn_soumettre');
                var btnAjouter    = document.getElementById('btn_ajouter_ligne');
                var tbody         = document.getElementById('tbody_lignes');
                var lblDate       = document.getElementById('lbl_date_expiration');
                var csrfToken     = document.querySelector('[name=csrf_token]').value;
                var lignesBcg     = [];
                var lineIndex     = 1;

                function buildProductOptions() {
                    var opts = '<option value="">-- Choisir --</option>';
                    lignesBcg.forEach(function (l) {
                        opts += '<option value="' + l.product_tmpl_id + '" ' +
                            'data-max="' + l.quantity_restante + '" ' +
                            'data-conds=\'' + JSON.stringify(l.conditionnements) + '\'>' +
                            l.product_name + ' (max ' + parseFloat(l.quantity_restante).toFixed(2) + ' T)' +
                            '</option>';
                    });
                    return opts;
                }

                function buildCondOptions(condList) {
                    var opts = '<option value="">-- Choisir --</option>';
                    condList.forEach(function (c) {
                        opts += '<option value="' + c.id + '">' + c.name + '</option>';
                    });
                    return opts;
                }

                function ajouterLigne() {
                    var idx = lineIndex++;
                    var productOpts = buildProductOptions();
                    var row = '<tr class="ligne-planif" data-index="' + idx + '">' +
                        '<td><select name="product_' + idx + '" class="form-select form-select-sm select-product" required style="pointer-events:auto;" data-index="' + idx + '">' + productOpts + '</select></td>' +
                        '<td><select name="cond_' + idx + '" class="form-select form-select-sm select-cond" required style="pointer-events:auto;" data-index="' + idx + '"><option value="">-- Choisir produit --</option></select></td>' +
                        '<td><input type="date" name="date_' + idx + '" class="form-control form-control-sm" style="pointer-events:auto;" required/></td>' +
                        '<td><input type="number" name="qty_' + idx + '" step="0.01" min="0.01" class="form-control form-control-sm input-qty" style="pointer-events:auto;" data-index="' + idx + '" required/></td>' +
                        '<td><input type="number" name="rotation_' + idx + '" min="1" value="1" class="form-control form-control-sm" style="pointer-events:auto;" required/></td>' +
                        '<td><button type="button" class="btn btn-sm btn-danger btn-suppr" style="pointer-events:auto;"><i class="fa fa-trash"></i></button></td>' +
                        '</tr>';
                    tbody.insertAdjacentHTML('beforeend', row);
                    attachListeners(tbody.lastElementChild);
                }

                function attachListeners(row) {
                    var selProduct = row.querySelector('.select-product');
                    var selCond    = row.querySelector('.select-cond');
                    var inputQty   = row.querySelector('.input-qty');
                    var btnSuppr   = row.querySelector('.btn-suppr');

                    if (selProduct) {
                        selProduct.addEventListener('change', function () {
                            var opt = this.options[this.selectedIndex];
                            var condList = [];
                            try { condList = JSON.parse(opt.getAttribute('data-conds') || '[]'); } catch(e) {}
                            var maxQty = parseFloat(opt.getAttribute('data-max') || 0);
                            selCond.innerHTML = buildCondOptions(condList);

                              // Auto-selection si un seul conditionnement disponible
                            if (condList.length === 1) {
                                    selCond.value = condList[0].id;
                            } 

                            if (inputQty) {
                                inputQty.max   = maxQty;
                                inputQty.value = '';
                            }
                        });
                    }

                    if (btnSuppr) {
                        btnSuppr.addEventListener('click', function () {
                            var rows = tbody.querySelectorAll('.ligne-planif');
                            if (rows.length > 1) row.remove();
                        });
                    }
                }

                tbody.querySelectorAll('.ligne-planif').forEach(attachListeners);
                // Declencher le chargement des conditionnements pour les lignes pre-existantes
                    tbody.querySelectorAll('.ligne-planif').forEach(function(row) {
                        var selProd = row.querySelector('.select-product');
                        if (selProd && selProd.value) {
                            selProd.dispatchEvent(new Event('change'));
                        }
                    });

                if (btnAjouter) {
                    btnAjouter.addEventListener('click', function () {
                        if (lignesBcg.length === 0) return;
                        ajouterLigne();
                    });
                }

                if (selectBcg) {
                    selectBcg.addEventListener('change', function () {
                        var bcgId = this.value;
                        if (!bcgId) {
                            infoBcg.style.display       = 'none';
                            sectionLignes.style.display = 'none';
                            sectionObs.style.display    = 'none';
                            btnSoumettre.disabled       = true;
                            tbody.innerHTML             = '';
                            lignesBcg                   = [];
                            return;
                        }

                        fetch('/my/gica/planifications/lignes_bcg', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRFToken': csrfToken,
                            },
                            body: JSON.stringify({
                                jsonrpc: '2.0', method: 'call', id: 1,
                                params: { bcg_id: parseInt(bcgId) },
                            }),
                        })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            var result = data.result || {};
                            lignesBcg = result.lignes || [];
                            lblDate.textContent   = result.date_expiration || '';
                            infoBcg.style.display = '';
                            lineIndex = 1;
                            tbody.innerHTML = '';
                            if (lignesBcg.length > 0) {
                                ajouterLigne();
                                lineIndex = 1;
                                sectionLignes.style.display = '';
                                sectionObs.style.display    = '';
                                btnSoumettre.disabled       = false;
                            } else {
                                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Aucun produit disponible dans ce BCG.</td></tr>';
                                btnSoumettre.disabled = true;
                            }
                        })
                        .catch(function (err) { console.error(err); });
                    });
                }
            });
            // Si BCG déjà sélectionné au chargement (retour après erreur)
                if (selectBcg && selectBcg.value) {
                    selectBcg.dispatchEvent(new Event('change'));
                }
            //]]>
            </script>
        </t>
    </template>
    <!-- Detail planification -->
    <template id="portail_gica_planification_detail" name="Portail GICA Planification Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/home">Accueil</a></li>
                        <li class="breadcrumb-item">
                            <a href="/my/gica/planifications">Mes Planifications</a>
                        </li>
                        <li class="breadcrumb-item active"><t t-esc="planif.name"/></li>
                    </ol>
                </nav>

                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between" style="background-color:#2699E6;">
                        <h5 class="mb-0 text-white">
                            <i class="fa fa-calendar me-2"/>
                            Planification <t t-esc="planif.name"/>
                        </h5>
                        <t t-if="planif.state == 'brouillon'">
                            <span class="badge bg-secondary align-self-center">Brouillon</span>
                        </t>
                        <t t-elif="planif.state == 'soumise'">
                            <span class="badge bg-dark align-self-center">En attente validation</span>
                        </t>
                        <t t-elif="planif.state == 'validee'">
                            <span class="badge bg-success align-self-center">Validee</span>
                        </t>
                        <t t-elif="planif.state == 'refusee'">
                            <span class="badge bg-danger align-self-center">Refusee</span>
                        
                        </t>

                    </div>
                    <div class="card-body">

                        <!-- Informations generales -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-muted mb-3">SELECTION</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="fw-bold" style="width:40%">BCG</td>
                                        <td>
                                            <a t-att-href="'/my/gica/bcg/%d' % planif.commande_globale_id.id">
                                                <t t-esc="planif.commande_globale_id.name"/>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Contrat</td>
                                        <td><t t-esc="planif.contrat_id.name"/></td>
                                    </tr>
                                    <t t-if="planif.state == 'refusee' and planif.motif_refus">
                                        <tr>
                                            <td class="fw-bold text-danger">Motif refus</td>
                                            <td class="text-danger">
                                                <t t-esc="planif.motif_refus"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>

                        <!-- Lignes produits -->
                        <h6 class="fw-bold text-muted mb-3">PRODUITS DEMANDES</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produit</th>
                                        <th>Conditionnement</th>
                                        <th>Date enlevement</th>
                                        <th class="text-end">Qte (T)</th>
                                        <th class="text-end">Rotations</th>
                                        <th class="text-end">Disponible BCG (T)</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="planif.line_ids" t-as="ligne">
                                        <tr>
                                            <td><t t-esc="ligne.product_tmpl_id.name"/></td>
                                            <td><t t-esc="ligne.conditionnement_id.name or '-'"/></td>
                                            <td><t t-esc="ligne.date_enlevement"/></td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % ligne.quantity_tonne"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="ligne.rotation"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % ligne.quantity_disponible"/>
                                            </td>
                                            <td>
                                                <t t-if="ligne.state == 'en_attente'">
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                </t>
                                                <t t-elif="ligne.state == 'validee'">
                                                    <span class="badge bg-success">Validee</span>
                                                </t>
                                                <t t-elif="ligne.state == 'refusee'">
                                                    <span class="badge bg-danger">Refusee</span>
                                                    <t t-if="ligne.motif_refus">
                                                        <small class="text-danger">
                                                            <i class="fa fa-exclamation-circle"/>
                                                            <t t-esc="ligne.motif_refus"/>
                                                        </small>
                                                    </t>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Bouton retour -->
                        <a href="/my/gica/planifications" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"/> Retour
                        </a>

                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
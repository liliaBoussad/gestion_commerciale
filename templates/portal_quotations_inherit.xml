<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_quotations_gica" name="Portail Devis GICA"
              inherit_id="sale.portal_my_quotations">

        <!-- Bouton demander un devis -->
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
            <div class="mt-3 mb-3">
                <a href="/my/gica/devis/demande" class="btn btn-primary">
                    <i class="fa fa-plus"/> Demander un devis
                </a>
            </div>
        </xpath>

        <!-- Remplacer le tableau -->
        <xpath expr="//t[@t-if='quotations']" position="replace">
            <t t-if="quotations">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Produits</th>
                                <th>Montant</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="quotations" t-as="quotation">
                                <tr>
                                    <td>
                                        <a t-att-href="quotation.get_portal_url()">
                                            <t t-esc="quotation.name"/>
                                        </a>
                                    </td>
                                    <td><t t-esc="quotation.date_order"/></td>
                                    <td>
                                        <t t-foreach="quotation.order_line" t-as="line">
                                            <small><t t-esc="line.product_id.name"/></small><br/>
                                        </t>
                                    </td>
                                    <td><t t-esc="quotation.amount_total"/></td>
                                    <td>
                                        <a t-att-href="quotation.get_portal_url()"
                                           class="btn btn-sm btn-outline-primary">
                                            Voir
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
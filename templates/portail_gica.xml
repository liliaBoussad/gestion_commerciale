            <script type="text/javascript">
            //<![CDATA[
            document.addEventListener('DOMContentLoaded', function () {
                var tbody     = document.getElementById('tbody_produits');
                var btnAjouter = document.getElementById('btn_ajouter');
                var lineIndex  = 1;

                function buildCondOptions(condList) {
                    var opts = '<option value="">-- Choisir --</option>';
                    condList.forEach(function (c) {
                        opts += '<option value="' + c.id + '">' + c.name + '</option>';
                    });
                    return opts;
                }

                function buildProductOptions() {
                    var first = document.querySelector('.select-product');
                    return first ? first.innerHTML : '';
                }

                function ajouterLigne() {
                    var idx = lineIndex++;
                    var row = '<tr class="ligne-produit" data-index="' + idx + '">' +
                        '<td><select name="product_' + idx + '" class="form-select form-select-sm select-product" required style="pointer-events:auto;">' + buildProductOptions() + '</select></td>' +
                       
                        '<td><input type="number" name="qty_' + idx + '" step="0.01" min="0.01" class="form-control form-control-sm" style="pointer-events:auto;" required/></td>' +
                        '<td><button type="button" class="btn btn-sm btn-danger btn-suppr" style="pointer-events:auto;"><i class="fa fa-trash"></i></button></td>' +
                        '</tr>';
                    tbody.insertAdjacentHTML('beforeend', row);
                    attachListeners(tbody.lastElementChild);
                    tbody.lastElementChild.querySelector('.select-product').value = '';
                }

               function attachListeners(row) {
                    var btnSuppr = row.querySelector('.btn-suppr');

                    if (btnSuppr) {
                        btnSuppr.addEventListener('click', function () {
                            if (tbody.querySelectorAll('.ligne-produit').length > 1) row.remove();
                        });
                    }
                }

                tbody.querySelectorAll('.ligne-produit').forEach(attachListeners);
                if (btnAjouter) btnAjouter.addEventListener('click', ajouterLigne);
            });
            //]]>
            </script>
        </t>
    </template>


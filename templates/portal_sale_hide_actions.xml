<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_order_portal_template_gica"
              inherit_id="sale.sale_order_portal_template">

        <!-- Supprimer les boutons du haut -->
        <xpath expr="//div[@id='sale_order_sidebar_button']"
               position="replace">
        </xpath>

        <!-- Supprimer les boutons du bas -->
        <xpath expr="//div[@name='sale_order_actions']"
               position="replace">
        </xpath>

        <!-- Supprimer l'historique / commentaires -->
        <xpath expr="//div[@id='sale_order_communication']"
               position="replace">
        </xpath>

    </template>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         TABLEAU DE BORD PORTAIL — Odoo 18
    ══════════════════════════════════════════════════ -->
    <template id="portal_my_home_gica" name="GICA Portal Home"
              inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <div class="o_portal_docs">
                <h4 class="mb-3 mt-4">Mon Espace GICA</h4>
                <div class="row">

                    <!-- Projets -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/projets" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-building fa-2x text-primary mb-2"/>
                                <h6 class="card-title">Mes Projets</h6>
                                <span class="badge bg-primary">
                                    <t t-esc="projet_count or 0"/>
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- BCG Ciment -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/bcg-ciment" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-file-text fa-2x text-success mb-2"/>
                                <h6 class="card-title">BCG Ciment</h6>
                                <span class="badge bg-success">
                                    <t t-esc="bcg_ciment_count or 0"/>
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- Planif Ciment -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/planif-ciment" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-calendar fa-2x text-warning mb-2"/>
                                <h6 class="card-title">Planifications Ciment</h6>
                                <span class="badge bg-warning">
                                    <t t-esc="planif_ciment_count or 0"/>
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- BCG Clinker -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/bcg-clinker" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-industry fa-2x text-danger mb-2"/>
                                <h6 class="card-title">BCG Clinker</h6>
                                <span class="badge bg-danger">
                                    <t t-esc="bcg_clinker_count or 0"/>
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- Planif Clinker -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/planif-clinker" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-calendar-check-o fa-2x text-info mb-2"/>
                                <h6 class="card-title">Planifications Clinker</h6>
                                <span class="badge bg-info">
                                    <t t-esc="planif_clinker_count or 0"/>
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- Historique -->
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                        <a href="/my/historique" class="card text-decoration-none h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-history fa-2x text-secondary mb-2"/>
                                <h6 class="card-title">Mon Historique</h6>
                            </div>
                        </a>
                    </div>

                </div>
            </div>
        </xpath>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC2 — PROJETS
    ══════════════════════════════════════════════════ -->
    <template id="portal_projets" name="Mes Projets">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Mes Projets</h3>
                    <a href="/my/projets/new" class="btn btn-primary">➕ Nouveau Projet</a>
                </div>
                <t t-if="not projets">
                    <div class="alert alert-info">Aucun projet enregistré.</div>
                </t>
                <t t-else="">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Nom</th>
                                <th>Produit</th>
                                <th>Quantité (T)</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="projets" t-as="p">
                                <tr>
                                    <td><t t-esc="p.name"/></td>
                                    <td><t t-esc="p.product_id.name if p.product_id else '—'"/></td>
                                    <td><t t-esc="p.quantite_estimee"/></td>
                                    <td><span class="badge bg-warning"><t t-esc="p.state"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_projet_form" name="Nouveau Projet">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Nouveau Projet</h3>
                <form action="/my/projets/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">Nom du projet *</label>
                        <input type="text" name="name" class="form-control" required="1"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Produit *</label>
                        <select name="product_id" class="form-select" required="1">
                            <option value="">-- Sélectionner --</option>
                            <t t-foreach="products" t-as="prod">
                                <option t-att-value="prod.id"><t t-esc="prod.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantité estimée (T) *</label>
                        <input type="number" name="quantite_estimee" class="form-control"
                               step="0.01" min="0" required="1"/>
                    </div>
                    <button type="submit" class="btn btn-primary">Soumettre</button>
                    <a href="/my/projets" class="btn btn-secondary ms-2">Annuler</a>
                </form>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC3 — BCG CIMENT
    ══════════════════════════════════════════════════ -->
    <template id="portal_bcg_ciment" name="Mes BCG Ciment">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Mes Commandes Globales Ciment</h3>
                    <a href="/my/bcg-ciment/new" class="btn btn-primary">➕ Nouveau BCG</a>
                </div>
                <t t-if="not bcgs">
                    <div class="alert alert-info">Aucune commande globale.</div>
                </t>
                <t t-else="">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Référence</th>
                                <th>Date</th>
                                <th>Expiration</th>
                                <th>Qté (T)</th>
                                <th>Restant (T)</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="bcgs" t-as="b">
                                <tr>
                                    <td><t t-esc="b.name"/></td>
                                    <td><t t-esc="b.date_commande"/></td>
                                    <td><t t-esc="b.date_expiration"/></td>
                                    <td><t t-esc="b.quantity_total_tonne"/></td>
                                    <td><t t-esc="b.quantity_restante"/></td>
                                    <td><span class="badge bg-success"><t t-esc="b.state"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_bcg_ciment_form" name="Nouveau BCG Ciment">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Nouveau BCG Ciment</h3>
                <form action="/my/bcg-ciment/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">Contrat *</label>
                        <select name="contrat_id" class="form-select" required="1">
                            <option value="">-- Sélectionner un contrat --</option>
                            <t t-foreach="contrats" t-as="c">
                                <option t-att-value="c.id"><t t-esc="c.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Produit *</label>
                        <select name="product_id" class="form-select" required="1">
                            <option value="">-- Sélectionner --</option>
                            <t t-foreach="products" t-as="prod">
                                <option t-att-value="prod.id"><t t-esc="prod.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Quantité (T) *</label>
                            <input type="number" name="quantity_tonne" class="form-control"
                                   step="0.01" min="0" required="1"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date commande *</label>
                            <input type="date" name="date_commande" class="form-control" required="1"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date expiration *</label>
                            <input type="date" name="date_expiration" class="form-control" required="1"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Soumettre</button>
                    <a href="/my/bcg-ciment" class="btn btn-secondary ms-2">Annuler</a>
                </form>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC3 — BCG CLINKER
    ══════════════════════════════════════════════════ -->
    <template id="portal_bcg_clinker" name="Mes BCG Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Mes Commandes Globales Clinker</h3>
                    <a href="/my/bcg-clinker/new" class="btn btn-primary">➕ Nouveau BCG</a>
                </div>
                <t t-if="not bcgs">
                    <div class="alert alert-info">Aucune commande globale clinker.</div>
                </t>
                <t t-else="">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Référence</th>
                                <th>Date</th>
                                <th>Expiration</th>
                                <th>Total (T)</th>
                                <th>Restant (T)</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="bcgs" t-as="b">
                                <tr>
                                    <td><t t-esc="b.name"/></td>
                                    <td><t t-esc="b.date_commande"/></td>
                                    <td><t t-esc="b.date_expiration"/></td>
                                    <td><t t-esc="b.total_autorise"/></td>
                                    <td><t t-esc="b.total_restant"/></td>
                                    <td><span class="badge bg-info"><t t-esc="b.state"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_bcg_clinker_form" name="Nouveau BCG Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Nouveau BCG Clinker</h3>
                <form action="/my/bcg-clinker/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">Réf. Bon de Commande</label>
                        <input type="text" name="ref_bon_commande" class="form-control"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Produit Clinker *</label>
                        <select name="product_id" class="form-select" required="1">
                            <option value="">-- Sélectionner --</option>
                            <t t-foreach="products" t-as="prod">
                                <option t-att-value="prod.id"><t t-esc="prod.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Quantité Autorisée (T) *</label>
                            <input type="number" name="quantite_autorisee" class="form-control"
                                   step="0.01" min="0" required="1"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date commande *</label>
                            <input type="date" name="date_commande" class="form-control" required="1"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date expiration *</label>
                            <input type="date" name="date_expiration" class="form-control" required="1"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Soumettre</button>
                    <a href="/my/bcg-clinker" class="btn btn-secondary ms-2">Annuler</a>
                </form>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC4 — PLANIFICATION CIMENT
    ══════════════════════════════════════════════════ -->
    <template id="portal_planif_ciment" name="Mes Planifications Ciment">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Mes Planifications Ciment</h3>
                    <a href="/my/planif-ciment/new" class="btn btn-primary">➕ Nouvelle Planification</a>
                </div>
                <t t-if="not planifs">
                    <div class="alert alert-info">Aucune planification.</div>
                </t>
                <t t-else="">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Référence</th>
                                <th>Date enlèvement</th>
                                <th>BCG</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="planifs" t-as="p">
                                <tr>
                                    <td><t t-esc="p.name"/></td>
                                    <td><t t-esc="p.date_enlevement"/></td>
                                    <td><t t-esc="p.commande_globale_id.name"/></td>
                                    <td><span class="badge bg-warning"><t t-esc="p.state"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_planif_ciment_form" name="Nouvelle Planification Ciment">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Nouvelle Planification Ciment</h3>
                <t t-if="not bcgs">
                    <div class="alert alert-warning">Aucun BCG Ciment actif.</div>
                    <a href="/my/bcg-ciment" class="btn btn-secondary">Retour</a>
                </t>
                <t t-else="">
                    <form action="/my/planif-ciment/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label">BCG Ciment *</label>
                            <select name="commande_globale_id" class="form-select" required="1">
                                <option value="">-- Sélectionner un BCG --</option>
                                <t t-foreach="bcgs" t-as="b">
                                    <option t-att-value="b.id">
                                        <t t-esc="b.name"/> — Restant: <t t-esc="b.quantity_restante"/> T
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date d'enlèvement *</label>
                            <input type="date" name="date_enlevement" class="form-control" required="1"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Soumettre</button>
                        <a href="/my/planif-ciment" class="btn btn-secondary ms-2">Annuler</a>
                    </form>
                </t>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC4 — PLANIFICATION CLINKER
    ══════════════════════════════════════════════════ -->
    <template id="portal_planif_clinker" name="Mes Planifications Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Mes Planifications Clinker</h3>
                    <a href="/my/planif-clinker/new" class="btn btn-primary">➕ Nouvelle Planification</a>
                </div>
                <t t-if="not planifs">
                    <div class="alert alert-info">Aucune planification clinker.</div>
                </t>
                <t t-else="">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Référence</th>
                                <th>Date chargement</th>
                                <th>BCG</th>
                                <th>Estimation (T)</th>
                                <th>Approuvé (T)</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="planifs" t-as="p">
                                <tr>
                                    <td><t t-esc="p.name"/></td>
                                    <td><t t-esc="p.date_chargement"/></td>
                                    <td><t t-esc="p.bcg_id.name"/></td>
                                    <td><t t-esc="p.estimation"/></td>
                                    <td><t t-esc="p.quantite_approuvee"/></td>
                                    <td><span class="badge bg-warning"><t t-esc="p.state"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_planif_clinker_form" name="Nouvelle Planification Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Nouvelle Planification Clinker</h3>
                <t t-if="not bcgs">
                    <div class="alert alert-warning">Aucun BCG Clinker actif.</div>
                    <a href="/my/bcg-clinker" class="btn btn-secondary">Retour</a>
                </t>
                <t t-else="">
                    <form action="/my/planif-clinker/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label">BCG Clinker *</label>
                            <select name="bcg_id" class="form-select" required="1">
                                <option value="">-- Sélectionner un BCG --</option>
                                <t t-foreach="bcgs" t-as="b">
                                    <option t-att-value="b.id">
                                        <t t-esc="b.name"/> — Restant: <t t-esc="b.total_restant"/> T
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date de chargement *</label>
                            <input type="date" name="date_chargement" class="form-control" required="1"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estimation (T) *</label>
                            <input type="number" name="estimation" class="form-control"
                                   step="0.01" min="0" required="1"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Soumettre</button>
                        <a href="/my/planif-clinker" class="btn btn-secondary ms-2">Annuler</a>
                    </form>
                </t>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         UC5 — HISTORIQUE
    ══════════════════════════════════════════════════ -->
    <template id="portal_historique" name="Mon Historique">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Mon Historique GICA</h3>

                <h5 class="mt-4 text-success">BCG Ciment</h5>
                <table class="table table-sm table-striped">
                    <thead class="table-secondary">
                        <tr><th>Référence</th><th>Date</th><th>Qté (T)</th><th>Statut</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="bcgs_ciment" t-as="b">
                            <tr>
                                <td><t t-esc="b.name"/></td>
                                <td><t t-esc="b.date_commande"/></td>
                                <td><t t-esc="b.quantity_total_tonne"/></td>
                                <td><t t-esc="b.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h5 class="mt-4 text-danger">BCG Clinker</h5>
                <table class="table table-sm table-striped">
                    <thead class="table-secondary">
                        <tr><th>Référence</th><th>Date</th><th>Total (T)</th><th>Statut</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="bcgs_clinker" t-as="b">
                            <tr>
                                <td><t t-esc="b.name"/></td>
                                <td><t t-esc="b.date_commande"/></td>
                                <td><t t-esc="b.total_autorise"/></td>
                                <td><t t-esc="b.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h5 class="mt-4 text-warning">Planifications Ciment</h5>
                <table class="table table-sm table-striped">
                    <thead class="table-secondary">
                        <tr><th>Référence</th><th>Date</th><th>BCG</th><th>Statut</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="planifs_ciment" t-as="p">
                            <tr>
                                <td><t t-esc="p.name"/></td>
                                <td><t t-esc="p.date_enlevement"/></td>
                                <td><t t-esc="p.commande_globale_id.name"/></td>
                                <td><t t-esc="p.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h5 class="mt-4 text-info">Planifications Clinker</h5>
                <table class="table table-sm table-striped">
                    <thead class="table-secondary">
                        <tr><th>Référence</th><th>Date</th><th>BCG</th><th>Estimation (T)</th><th>Statut</th></tr>
                    </thead>
                    <tbody>
                        <t t-foreach="planifs_clinker" t-as="p">
                            <tr>
                                <td><t t-esc="p.name"/></td>
                                <td><t t-esc="p.date_chargement"/></td>
                                <td><t t-esc="p.bcg_id.name"/></td>
                                <td><t t-esc="p.estimation"/></td>
                                <td><t t-esc="p.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- PAS DE CONTRAT ACTIF -->
    <template id="portal_no_contrat" name="Pas de contrat actif">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="alert alert-danger">
                    <h4>❌ Aucun contrat actif</h4>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des BCG Clinker -->
    <template id="portail_gica_bcg_clinker" name="Portail GICA BCG Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4><i class="fa fa-industry me-2"/>Mes BCG Clinker</h4>
                    <a href="/my/home" class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-arrow-left"/> Retour
                    </a>
                </div>

                <t t-set="erreur" t-value="request.params.get('erreur')"/>
                <t t-set="succes" t-value="request.params.get('succes')"/>
                <t t-set="ref"    t-value="request.params.get('ref')"/>

                <t t-if="succes == 'bcg_soumis'">
                    <div class="alert alert-success">
                        Votre BCG Clinker <strong><t t-esc="ref"/></strong> a ete soumis.
                        Il sera traite par la production.
                    </div>
                </t>

                <t t-if="peut_creer">
                    <a href="/my/gica/bcg-clinker/nouveau" class="btn btn-primary mb-3">
                        <i class="fa fa-plus"/> Nouveau BCG Clinker
                    </a>
                </t>

                <t t-if="not bcgs">
                    <div class="alert alert-info">Aucun BCG Clinker pour le moment.</div>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Reference</th>
                                    <th>Date</th>
                                    <th>Expiration</th>
                                    <th>Qte autorisee (T)</th>
                                    <th>Qte restante (T)</th>
                                    <th>Statut</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="bcgs" t-as="bcg">
                                    <tr>
                                        <td><strong><t t-esc="bcg.name"/></strong></td>
                                        <td><t t-esc="bcg.date_commande"/></td>
                                        <td><t t-esc="bcg.date_expiration"/></td>
                                        <td><t t-esc="'%.2f' % bcg.total_autorise"/></td>
                                        <td><t t-esc="'%.2f' % bcg.total_restant"/></td>
                                        <td>
                                            <t t-if="bcg.state == 'brouillon'">
                                                <span class="badge bg-secondary">soumis</span>
                                            </t>
                                            <t t-elif="bcg.state == 'soumis'">
                                                <span class="badge bg-warning text-dark">En attente</span>
                                            </t>
                                            <t t-elif="bcg.state == 'actif'">
                                                <span class="badge bg-success">Actif</span>
                                            </t>
                                            <t t-elif="bcg.state == 'termine'">
                                                <span class="badge bg-dark">Termine</span>
                                            </t>
                                            <t t-elif="bcg.state == 'bloque'">
                                                <span class="badge bg-danger">Bloque</span>
                                            </t>
                                        </td>
                                        <td>
                                            <a t-att-href="'/my/gica/bcg-clinker/%d' % bcg.id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-eye"/> Voir
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Detail BCG Clinker -->
    <template id="portail_gica_bcg_clinker_detail" name="Portail GICA BCG Clinker Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">

                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/home">Accueil</a></li>
                        <li class="breadcrumb-item">
                            <a href="/my/gica/bcg-clinker">Mes BCG Clinker</a>
                        </li>
                        <li class="breadcrumb-item active"><t t-esc="bcg.name"/></li>
                    </ol>
                </nav>

                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white d-flex justify-content-between">
                        <h5 class="mb-0">
                            <i class="fa fa-industry me-2"/>
                            BCG Clinker <t t-esc="bcg.name"/>
                        </h5>
                        <t t-if="bcg.state == 'brouillon'">
                            <span class="badge bg-secondary align-self-center">Brouillon</span>
                        </t>
                        <t t-elif="bcg.state == 'soumis'">
                            <span class="badge bg-warning text-dark align-self-center">En attente production</span>
                        </t>
                        <t t-elif="bcg.state == 'actif'">
                            <span class="badge bg-success align-self-center">Actif</span>
                        </t>
                        <t t-elif="bcg.state == 'termine'">
                            <span class="badge bg-light text-dark align-self-center">Termine</span>
                        </t>
                        <t t-elif="bcg.state == 'bloque'">
                            <span class="badge bg-danger align-self-center">Bloque</span>
                        </t>
                    </div>
                    <div class="card-body">

                        <t t-if="bcg.state == 'bloque' and bcg.motif_refus">
                            <div class="alert alert-danger">
                                <strong>Motif du blocage :</strong> <t t-esc="bcg.motif_refus"/>
                            </div>
                        </t>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-muted mb-3">INFORMATIONS</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="fw-bold" style="width:50%">Date de commande</td>
                                        <td><t t-esc="bcg.date_commande"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Date d expiration</td>
                                        <td><t t-esc="bcg.date_expiration"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-muted mb-3">QUANTITES</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="fw-bold" style="width:50%">Total autorise (T)</td>
                                        <td><t t-esc="'%.2f' % bcg.total_autorise"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Total livre (T)</td>
                                        <td><t t-esc="'%.2f' % bcg.total_livre"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Total restant (T)</td>
                                        <td><t t-esc="'%.2f' % bcg.total_restant"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <h6 class="fw-bold text-muted mb-3">PRODUITS</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produit</th>
                                        <th>Conditionnement</th>
                                        <th class="text-end">Qte autorisee (T)</th>
                                        <th class="text-end">Qte livree (T)</th>
                                        <th class="text-end">Qte restante (T)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="bcg.line_ids" t-as="ligne">
                                        <tr>
                                            <td><t t-esc="ligne.product_tmpl_id.name"/></td>
                                            <td><t t-esc="ligne.conditionnement_label"/></td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % ligne.quantite_autorisee"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % ligne.quantite_livree"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % ligne.quantite_restante"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <a href="/my/gica/bcg-clinker" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"/> Retour
                        </a>

                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Formulaire nouveau BCG Clinker -->
    <template id="portail_gica_bcg_clinker_form" name="Portail GICA Nouveau BCG Clinker">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">

                <t t-set="erreur" t-value="request.params.get('erreur')"/>
                <t t-if="erreur == 'lignes_vides'">
                    <div class="alert alert-danger">
                        Veuillez ajouter au moins un produit avec une quantite.
                    </div>
                </t>
                <t t-if="erreur == 'date_manquante'">
                    <div class="alert alert-danger">
                        Veuillez indiquer une date d expiration.
                    </div>
                </t>

                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">
                            <i class="fa fa-industry"/> Nouveau BCG Clinker
                        </h5>
                    </div>
                    <div class="card-body">

                        <div class="alert alert-info small mb-4">
                            <i class="fa fa-info-circle"/>
                            Le clinker est livre uniquement en Vrac.
                            Indiquez les quantites souhaitees et la date d expiration de la demande.
                        </div>

                        <form method="POST" action="/my/gica/bcg-clinker/soumettre" id="form_bcg_clinker">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    Date d expiration <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="date_expiration"
                                       class="form-control" style="pointer-events:auto;"
                                       required="1"/>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0">Produits</h6>
                                <button type="button" class="btn btn-sm btn-success"
                                        id="btn_ajouter_ligne"
                                        style="pointer-events:auto;">
                                    <i class="fa fa-plus"/> Ajouter un produit
                                </button>
                            </div>

                            <div class="table-responsive mb-4">
                                <table class="table table-bordered" id="table_lignes">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Produit (Vrac)</th>
                                            <th>Quantite (T)</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody_lignes">
                                        <tr class="ligne-bcg" data-index="0">
                                            <td>
                                                <select name="product_0"
                                                        class="form-select form-select-sm"
                                                        style="pointer-events:auto;"
                                                        required="1">
                                                    <option value="">-- Choisir --</option>
                                                    <t t-foreach="produits" t-as="prod">
                                                        <option t-att-value="prod.id">
                                                            <t t-esc="prod.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" name="qty_0"
                                                       step="0.01" min="0.01"
                                                       class="form-control form-control-sm"
                                                       style="pointer-events:auto;"
                                                       required="1"/>
                                            </td>
                                            <td>
                                                <button type="button"
                                                        class="btn btn-sm btn-danger btn-suppr"
                                                        style="pointer-events:auto;">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-paper-plane"/> Soumettre le BCG Clinker
                            </button>
                            <a href="/my/gica/bcg-clinker" class="btn btn-secondary">Annuler</a>
                        </form>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
            //<![CDATA[
            document.addEventListener('DOMContentLoaded', function () {
                var tbody      = document.getElementById('tbody_lignes');
                var btnAjouter = document.getElementById('btn_ajouter_ligne');
                var lineIndex  = 1;

                var selProd0    = tbody.querySelector('select[name="product_0"]');
                var prodOptions = selProd0 ? selProd0.innerHTML : '';

                function attachSuppr(row) {
                    var btn = row.querySelector('.btn-suppr');
                    if (btn) {
                        btn.addEventListener('click', function () {
                            var rows = tbody.querySelectorAll('.ligne-bcg');
                            if (rows.length > 1) row.remove();
                        });
                    }
                }

                tbody.querySelectorAll('.ligne-bcg').forEach(attachSuppr);

                if (btnAjouter) {
                    btnAjouter.addEventListener('click', function () {
                        var idx = lineIndex++;
                        var row =
                            '<tr class="ligne-bcg" data-index="' + idx + '">' +
                            '<td><select name="product_' + idx + '" class="form-select form-select-sm" style="pointer-events:auto;" required>' + prodOptions + '</select></td>' +
                            '<td><input type="number" name="qty_' + idx + '" step="0.01" min="0.01" class="form-control form-control-sm" style="pointer-events:auto;" required/></td>' +
                            '<td><button type="button" class="btn btn-sm btn-danger btn-suppr" style="pointer-events:auto;"><i class="fa fa-trash"/></button></td>' +
                            '</tr>';
                        tbody.insertAdjacentHTML('beforeend', row);
                        attachSuppr(tbody.lastElementChild);
                    });
                }
            });
            //]]>
            </script>
        </t>
    </template>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

  <!-- ══════════════════════════════════════════════════════
     Attribut Conditionnement
     ══════════════════════════════════════════════════════ -->

<record id="product_attribute_conditionnement" model="product.attribute">
    <field name="name">Conditionnement</field>
    <field name="display_type">radio</field>
    <field name="create_variant">always</field>
    <field name="sequence">20</field>
</record>

<record id="attr_val_sac_25kg" model="product.attribute.value">
    <field name="name">Sac 25kg</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_sac_50kg" model="product.attribute.value">
    <field name="name">Sac 50kg</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_sac_25kg_fardelise" model="product.attribute.value">
    <field name="name">Sac 25kg Fardelisé</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_sac_50kg_fardelise" model="product.attribute.value">
    <field name="name">Sac 50kg Fardelisé</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_vrac" model="product.attribute.value">
    <field name="name">Vrac</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_big_bag_client" model="product.attribute.value">
    <field name="name">Big Bag Client</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

<record id="attr_val_big_bag_scaek" model="product.attribute.value">
    <field name="name">Big Bag Scaek</field>
    <field name="attribute_id" ref="product_attribute_conditionnement"/>
</record>

    <!-- ══════════════════════════════════════════════════════
         CEM I 42.5 N-LH/SR5
         ══════════════════════════════════════════════════════ -->
    <record id="product_tmpl_cem_i_425" model="product.template">
        <field name="name">CEM I 42.5 N-LH/SR5</field>
        <field name="is_gica_product">True</field>
        <field name="type_ciment">cem_i_425_crs</field>
        <field name="type">consu</field>
        <field name="uom_id" ref="uom.product_uom_ton"/>
        <field name="uom_po_id" ref="uom.product_uom_ton"/>
        <field name="default_code">CEM_I_425</field>
    </record>
    <record id="product_tmpl_cem_i_425_attr_line" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="product_tmpl_cem_i_425"/>
        <field name="attribute_id" ref="product_attribute_conditionnement"/>
        <field name="value_ids" eval="[(6, 0, [ref('attr_val_sac_50kg'), ref('attr_val_sac_50kg_fardelise'), ref('attr_val_vrac')])]"/>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_gica_bon_circulation" model="ir.sequence">
            <field name="name">Bon de Circulation GICA</field>
            <field name="code">gica.bon.circulation</field>
            <field name="prefix">CIRC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_gica_bon_circulation_chaine" model="ir.sequence">
            <field name="name">N° Chaîne Circulation GICA</field>
            <field name="code">gica.bon.circulation.chaine</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_gica_pesee" model="ir.sequence">
            <field name="name">Pesée GICA</field>
            <field name="code">gica.pesee</field>
            <field name="prefix">PES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         Template QWeb — Ticket de Pesée
    ══════════════════════════════════════════════════ -->
    <template id="report_ticket_pesee_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- En-tête -->
                        <div style="text-align: center; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 15px;">
                            <h2 style="margin: 0; font-size: 20px; font-weight: bold; color: #333;">
                                BON DE CIRCULATION — TICKET DE PESÉE
                            </h2>
                            <h3 style="margin: 5px 0 0 0; font-size: 16px; color: #555;">
                                <t t-esc="doc.name"/>
                            </h3>
                        </div>

                        <!-- Infos principales en deux colonnes -->
                        <div style="display: flex; gap: 20px; margin-bottom: 20px;">

                            <!-- Colonne gauche : Commande -->
                            <div style="flex: 1; border: 1px solid #ddd; padding: 12px; border-radius: 4px;">
                                <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666; text-transform: uppercase; border-bottom: 1px solid #eee; padding-bottom: 6px;">
                                    Informations Commande
                                </h4>
                                <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 3px 0; color: #666; width: 45%;">Bon de Commande</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="doc.sale_order_id.name or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Client</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="doc.sale_order_id.partner_id.name or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Produit</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="doc.product_id.display_name or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Conditionnement</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="dict(doc._fields['conditionnement'].selection).get(doc.conditionnement, '—')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Qté prévue</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="'%.2f T' % doc.quantite_prevue"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">N° Chaîne</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.numero_chaine or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">N° Rotation</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.numero_rotation"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Colonne droite : Camion -->
                            <div style="flex: 1; border: 1px solid #ddd; padding: 12px; border-radius: 4px;">
                                <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666; text-transform: uppercase; border-bottom: 1px solid #eee; padding-bottom: 6px;">
                                    Logistique &amp; Camion
                                </h4>
                                <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 3px 0; color: #666; width: 45%;">Chauffeur</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="doc.chauffeur or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Matricule</td>
                                        <td style="padding: 3px 0; font-weight: bold;">
                                            <t t-esc="doc.matricule or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Camion</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.camion or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Remorque</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.remorque or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">Destination</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.lieu_livraison or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 0; color: #666;">N° Permis</td>
                                        <td style="padding: 3px 0;">
                                            <t t-esc="doc.numero_permis or '—'"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Tableau des pesées -->
                        <div style="border: 2px solid #333; border-radius: 4px; margin-bottom: 20px; overflow: hidden;">
                            <div style="background: #333; color: white; padding: 8px 12px; font-size: 13px; font-weight: bold; text-transform: uppercase;">
                                Résultats des Pesées
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="background: #f5f5f5;">
                                        <th style="padding: 8px 12px; text-align: left; border-bottom: 1px solid #ddd; color: #666;">Pesée</th>
                                        <th style="padding: 8px 12px; text-align: center; border-bottom: 1px solid #ddd; color: #666;">Type</th>
                                        <th style="padding: 8px 12px; text-align: right; border-bottom: 1px solid #ddd; color: #666;">Poids (T)</th>
                                        <th style="padding: 8px 12px; text-align: center; border-bottom: 1px solid #ddd; color: #666;">Agent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; font-weight: bold;">Tare P1</td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: center; color: #555;">Pesée à vide (Entrée)</td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: right; font-size: 15px; font-weight: bold;">
                                            <t t-esc="'%.3f' % doc.tare_p1"/>
                                        </td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: center;">
                                            <t t-foreach="doc.env['gica.pesee'].search([('bon_circulation_id','=',doc.id),('type_pesee','=','vide')], limit=1)" t-as="p1">
                                                <t t-esc="p1.agent_pesage_id.name"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; font-weight: bold;">Poids Brut P2</td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: center; color: #555;">Pesée en charge (Sortie)</td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: right; font-size: 15px; font-weight: bold;">
                                            <t t-esc="'%.3f' % doc.poids_brut_p2"/>
                                        </td>
                                        <td style="padding: 10px 12px; border-bottom: 1px solid #eee; text-align: center;">
                                            <t t-foreach="doc.env['gica.pesee'].search([('bon_circulation_id','=',doc.id),('type_pesee','=','charge')], limit=1)" t-as="p2">
                                                <t t-esc="p2.agent_pesage_id.name"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <!-- Poids Net -->
                                    <tr style="background: #f0f8f0;">
                                        <td style="padding: 12px; font-weight: bold; font-size: 14px;">POIDS NET</td>
                                        <td style="padding: 12px; text-align: center; color: #555;">P2 − P1</td>
                                        <td style="padding: 12px; text-align: right; font-size: 18px; font-weight: bold; color: #2d7a2d;">
                                            <t t-esc="'%.3f' % doc.poids_net"/> T
                                        </td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- QR Code -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                            <div t-if="doc.qr_code" style="text-align: center;">
                                <img t-att-src="'data:image/png;base64,' + doc.qr_code.decode('utf-8') if isinstance(doc.qr_code, bytes) else 'data:image/png;base64,' + doc.qr_code"
                                     style="width: 100px; height: 100px;"/>
                                <div style="font-size: 10px; color: #666; margin-top: 4px;">Code QR — <t t-esc="doc.name"/></div>
                            </div>

                            <!-- Signatures -->
                            <div style="flex: 1; margin-left: 30px;">
                                <table style="width: 100%; font-size: 12px; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px; text-align: center; width: 33%;">
                                            <div style="border-top: 1px solid #333; padding-top: 6px; margin-top: 40px; color: #666;">
                                                Agent Bascule
                                            </div>
                                        </td>
                                        <td style="padding: 8px; text-align: center; width: 33%;">
                                            <div style="border-top: 1px solid #333; padding-top: 6px; margin-top: 40px; color: #666;">
                                                Chauffeur
                                            </div>
                                        </td>
                                        <td style="padding: 8px; text-align: center; width: 33%;">
                                            <div style="border-top: 1px solid #333; padding-top: 6px; margin-top: 40px; color: #666;">
                                                Responsable Usine
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Pied de page -->
                        <div style="border-top: 1px solid #ddd; padding-top: 10px; font-size: 10px; color: #999; text-align: center;">
                            Document généré le <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/> —
                            GICA — Bon de Circulation <t t-esc="doc.name"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         Déclaration du rapport
    ══════════════════════════════════════════════════ -->
    <record id="report_ticket_pesee" model="ir.actions.report">
        <field name="name">Ticket de Pesée</field>
        <field name="model">gica.bon.circulation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_commerciale.report_ticket_pesee_template</field>
        <field name="report_file">gestion_commerciale.report_ticket_pesee_template</field>
        <field name="binding_model_id" ref="model_gica_bon_circulation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
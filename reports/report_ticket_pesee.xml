<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_ticket_pesee_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #222; padding: 12px; max-height: 270mm;">

                    <!-- EN-TÊTE compact -->
                    <div style="background: #1a3a5c; color: white; padding: 10px 16px; border-radius: 4px 4px 0 0; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 8px; text-transform: uppercase; letter-spacing: 2px; opacity: 0.7;">GICA — Société des Ciments d'Aïn El Kébira</div>
                            <div style="font-size: 16px; font-weight: bold; margin-top: 2px;">BON DE CIRCULATION — TICKET DE PESÉE</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 18px; font-weight: bold;"><t t-esc="doc.name"/></div>
                            <div style="font-size: 9px; opacity: 0.8;">Chaîne : <t t-esc="doc.numero_chaine or '—'"/> &#160;|&#160; Rotation N°<t t-esc="doc.numero_rotation"/></div>
                        </div>
                    </div>

                    <!-- BANDE ÉTAT -->
                    <div style="background: #2196f3; color: white; padding: 4px 16px; font-size: 10px; font-weight: bold; margin-bottom: 10px;">
                        État : <t t-esc="dict([('brouillon','Brouillon'),('transmis_tare','Transmis à la tare'),('pesee_entree','Pesée Entrée'),('chargement','Chargement'),('pesee_sortie','Pesée Sortie'),('termine','Terminé'),('annule','Annulé')]).get(doc.state, doc.state)"/>
                        &#160;&#160;|&#160;&#160; BC : <t t-esc="doc.sale_order_id.name or '—'"/>
                        &#160;&#160;|&#160;&#160; Client : <t t-esc="doc.sale_order_id.partner_id.name or '—'"/>
                    </div>

                    <!-- DEUX COLONNES INFOS -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 11px;">
                        <tr>
                            <!-- Commande -->
                            <td style="width: 50%; vertical-align: top; padding-right: 6px;">
                                <table style="width: 100%; border: 1px solid #ddd; border-collapse: collapse;">
                                    <tr>
                                        <td colspan="2" style="background: #f0f4f8; padding: 5px 8px; font-size: 10px; font-weight: bold; text-transform: uppercase; color: #1a3a5c; border-bottom: 1px solid #ddd;">
                                            Informations Commande
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 8px; color: #777; width: 40%; border-bottom: 1px solid #f0f0f0;">Produit</td>
                                        <td style="padding: 3px 8px; font-weight: bold; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.product_id.display_name or '—'"/></td>
                                    </tr>
                                    <tr style="background:#fafafa;">
                                        <td style="padding: 3px 8px; color: #777; border-bottom: 1px solid #f0f0f0;">Conditionnement</td>
                                        <td style="padding: 3px 8px; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.conditionnement or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 8px; color: #777; border-bottom: 1px solid #f0f0f0;">Qté prévue</td>
                                        <td style="padding: 3px 8px; font-weight: bold; color: #1a3a5c; border-bottom: 1px solid #f0f0f0;"><t t-esc="'%.3f T' % doc.quantite_prevue"/></td>
                                    </tr>
                                    <tr style="background:#fafafa;">
                                        <td style="padding: 3px 8px; color: #777;">Nb Paquets</td>
                                        <td style="padding: 3px 8px;"><t t-esc="doc.nbr_paquets or '—'"/></td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Camion -->
                            <td style="width: 50%; vertical-align: top; padding-left: 6px;">
                                <table style="width: 100%; border: 1px solid #ddd; border-collapse: collapse;">
                                    <tr>
                                        <td colspan="2" style="background: #f0f4f8; padding: 5px 8px; font-size: 10px; font-weight: bold; text-transform: uppercase; color: #1a3a5c; border-bottom: 1px solid #ddd;">
                                            Logistique &amp; Camion
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 8px; color: #777; width: 40%; border-bottom: 1px solid #f0f0f0;">Chauffeur</td>
                                        <td style="padding: 3px 8px; font-weight: bold; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.chauffeur or '—'"/></td>
                                    </tr>
                                    <tr style="background:#fafafa;">
                                        <td style="padding: 3px 8px; color: #777; border-bottom: 1px solid #f0f0f0;">Matricule</td>
                                        <td style="padding: 3px 8px; font-weight: bold; color: #1a3a5c; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.matricule or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 8px; color: #777; border-bottom: 1px solid #f0f0f0;">Camion</td>
                                        <td style="padding: 3px 8px; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.camion or '—'"/></td>
                                    </tr>
                                    <tr style="background:#fafafa;">
                                        <td style="padding: 3px 8px; color: #777; border-bottom: 1px solid #f0f0f0;">Destination</td>
                                        <td style="padding: 3px 8px; font-weight: bold; border-bottom: 1px solid #f0f0f0;"><t t-esc="doc.lieu_livraison or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 8px; color: #777;">N° Permis</td>
                                        <td style="padding: 3px 8px;"><t t-esc="doc.numero_permis or '—'"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- TABLEAU PESÉES -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 11px; border: 2px solid #1a3a5c;">
                        <tr>
                            <td colspan="4" style="background: #1a3a5c; color: white; padding: 6px 12px; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                                Resultats des Pesees
                            </td>
                        </tr>
                        <tr style="background: #f0f4f8;">
                            <th style="padding: 6px 12px; text-align: left; border-bottom: 1px solid #ddd; color: #555; font-size: 10px;">Designation</th>
                            <th style="padding: 6px 12px; text-align: center; border-bottom: 1px solid #ddd; color: #555; font-size: 10px;">Type</th>
                            <th style="padding: 6px 12px; text-align: right; border-bottom: 1px solid #ddd; color: #555; font-size: 10px;">Poids (Tonnes)</th>
                            <th style="padding: 6px 12px; text-align: center; border-bottom: 1px solid #ddd; color: #555; font-size: 10px;">Agent / Date</th>
                        </tr>
                        <!-- P1 -->
                        <tr>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; font-weight: bold;">Tare P1</td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: center; color: #1565c0;">Pesee a vide (Entree)</td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: right; font-size: 14px; font-weight: bold; color: #1565c0;">
                                <t t-esc="'%.3f' % doc.tare_p1"/>
                            </td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: center; font-size: 10px; color: #555;">
                                <t t-foreach="doc.env['gica.pesee'].search([('bon_circulation_id','=',doc.id),('type_pesee','=','vide')], limit=1)" t-as="p1">
                                    <div><t t-esc="p1.agent_pesage_id.name"/></div>
                                    <div style="color: #999;"><t t-esc="p1.date_pesee.strftime('%d/%m/%Y %H:%M') if p1.date_pesee else ''"/></div>
                                </t>
                            </td>
                        </tr>
                        <!-- P2 -->
                        <tr style="background: #fafafa;">
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; font-weight: bold;">Poids Brut P2</td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: center; color: #2e7d32;">Pesee en charge (Sortie)</td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: right; font-size: 14px; font-weight: bold; color: #2e7d32;">
                                <t t-esc="'%.3f' % doc.poids_brut_p2"/>
                            </td>
                            <td style="padding: 8px 12px; border-bottom: 1px solid #eee; text-align: center; font-size: 10px; color: #555;">
                                <t t-foreach="doc.env['gica.pesee'].search([('bon_circulation_id','=',doc.id),('type_pesee','=','charge')], limit=1)" t-as="p2">
                                    <div><t t-esc="p2.agent_pesage_id.name"/></div>
                                    <div style="color: #999;"><t t-esc="p2.date_pesee.strftime('%d/%m/%Y %H:%M') if p2.date_pesee else ''"/></div>
                                </t>
                            </td>
                        </tr>
                        <!-- NET -->
                        <tr style="background: #e8f5e9;">
                            <td style="padding: 10px 12px; font-weight: bold; font-size: 13px; color: #1b5e20;">POIDS NET</td>
                            <td style="padding: 10px 12px; text-align: center; color: #555; font-size: 10px;">P2 - P1</td>
                            <td style="padding: 10px 12px; text-align: right; font-size: 20px; font-weight: bold; color: #1b5e20;">
                                <t t-esc="'%.3f' % doc.poids_net"/> T
                            </td>
                            <td></td>
                        </tr>
                    </table>

                    <!-- QR + SIGNATURES -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                        <tr>
                            <!-- QR Code -->
                            <td style="width: 110px; vertical-align: top; text-align: center; border: 1px solid #ddd; padding: 6px; border-radius: 4px;">
                                <t t-if="doc.qr_code">
                                    <img t-att-src="'data:image/png;base64,' + (doc.qr_code.decode('utf-8') if isinstance(doc.qr_code, bytes) else doc.qr_code)"
                                         style="width: 80px; height: 80px;"/>
                                    <div style="font-size: 8px; color: #888; margin-top: 3px; font-weight: bold;"><t t-esc="doc.name"/></div>
                                </t>
                            </td>
                            <!-- Signatures -->
                            <td style="vertical-align: bottom; padding-left: 12px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align: center; padding: 4px; width: 33%;">
                                            <div style="height: 40px; border-bottom: 1px solid #333;"></div>
                                            <div style="font-size: 10px; color: #666; margin-top: 4px; font-weight: 500;">Agent Bascule</div>
                                            <div style="font-size: 9px; color: #aaa;">Nom et Cachet</div>
                                        </td>
                                        <td style="text-align: center; padding: 4px; width: 33%;">
                                            <div style="height: 40px; border-bottom: 1px solid #333;"></div>
                                            <div style="font-size: 10px; color: #666; margin-top: 4px; font-weight: 500;">Chauffeur</div>
                                            <div style="font-size: 9px; color: #aaa;">Signature</div>
                                        </td>
                                        <td style="text-align: center; padding: 4px; width: 33%;">
                                            <div style="height: 40px; border-bottom: 1px solid #333;"></div>
                                            <div style="font-size: 10px; color: #666; margin-top: 4px; font-weight: 500;">Responsable Usine</div>
                                            <div style="font-size: 9px; color: #aaa;">Nom et Cachet</div>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- PIED DE PAGE -->
                    <div style="border-top: 2px solid #1a3a5c; padding-top: 6px; display: flex; justify-content: space-between;">
                        <div style="font-size: 8px; color: #999;">GICA — Societe des Ciments d'Ain El Kebira</div>
                        <div style="font-size: 8px; color: #999;">
                            Genere le <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y a %H:%M')"/>
                        </div>
                        <div style="font-size: 8px; color: #999;">Document confidentiel — Usage interne</div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <record id="report_ticket_pesee" model="ir.actions.report">
        <field name="name">Ticket de Pesee</field>
        <field name="model">gica.bon.circulation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_commerciale.report_ticket_pesee_template</field>
        <field name="report_file">gestion_commerciale.report_ticket_pesee_template</field>
        <field name="binding_model_id" ref="model_gica_bon_circulation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
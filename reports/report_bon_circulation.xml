<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_bon_circulation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.sale_order_id.company_id or env.company"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #222; padding: 0; margin: 0;">

                    <!-- EN-TETE GICA -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 2px solid #1a3a5c; margin-bottom: 8px;">
                        <tr>
                            <td style="width: 140px; vertical-align: middle; padding: 4px;">
                                <t t-if="company.logo">
                                    <img t-att-src="image_data_uri(company.logo)"
                                         style="width: 130px; height: auto;"/>
                                </t>
                            </td>
                            <td style="vertical-align: middle; text-align: center; padding: 4px;">
                                <div style="font-size: 16px; font-weight: bold; color: #1a3a5c;">
                                    GROUPE INDUSTRIEL DES CIMENTS D'ALGERIE
                                </div>
                                <div style="font-size: 13px; font-weight: bold; margin-top: 3px;">
                                    SOCIETE DES CIMENTS D'AIN EL KEBIRA
                                </div>
                                <div style="font-size: 12px; font-weight: bold;">&#171; S.C.A.E.K &#187;</div>
                            </td>
                            <!-- QR Code -->
                            <td style="width: 90px; vertical-align: middle; text-align: center; padding: 4px;">
                                <t t-if="doc.qr_code">
                                    <img t-att-src="image_data_uri(doc.qr_code)"
                                         style="width: 80px; height: 80px;"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- TITRE + NUMERO + DATE -->
                    <table style="width: 100%; border-collapse: collapse; border: 2px solid #1a3a5c; margin-bottom: 10px;">
                        <tr>
                            <td style="padding: 6px 12px; width: 30%; border-right: 1px solid #999; font-size: 11px;">
                                <b>Date :</b>
                                <t t-esc="doc.create_date.strftime('%d/%m/%Y') if doc.create_date else ''"/>
                            </td>
                            <td style="padding: 6px 12px; text-align: center; font-size: 20px; font-weight: bold; color: #1a3a5c; letter-spacing: 1px; border-right: 1px solid #999;">
                                BON DE CIRCULATION
                            </td>
                            <td style="padding: 6px 12px; text-align: right; font-size: 13px; font-weight: bold; width: 30%; color: #1a3a5c;">
                                N&#176; <t t-esc="doc.name"/>
                            </td>
                        </tr>
                    </table>

                    <!-- CLIENT -->
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #999; margin-bottom: 8px;">
                        <tr>
                            <td colspan="2" style="background: #1a3a5c; color: white; padding: 4px 10px; font-weight: bold; text-align: center; font-size: 11px; letter-spacing: 1px;">
                                CLIENT
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px; width: 50%; border-right: 1px solid #eee;">
                                <b>Client :</b>
                                <t t-esc="doc.sale_order_id.partner_id.name or ''"/>
                            </td>
                            <td style="padding: 6px 12px;">
                                <b>N&#176; Chaine :</b>
                                <span style="font-size: 13px; font-weight: bold; color: #1a3a5c;">
                                    <t t-esc="doc.numero_chaine or ''"/>
                                </span>
                            </td>
                        </tr>
                    </table>

                    <!-- PRODUIT -->
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #999; margin-bottom: 10px;">
                        <tr>
                            <td colspan="3" style="background: #1a3a5c; color: white; padding: 4px 10px; font-weight: bold; text-align: center; font-size: 11px; letter-spacing: 1px;">
                                PRODUIT
                            </td>
                        </tr>
                        <tr style="background: #f5f7fa;">
                            <th style="padding: 5px 10px; border: 1px solid #ccc; text-align: center; font-size: 11px; width: 45%;">Designation</th>
                            <th style="padding: 5px 10px; border: 1px solid #ccc; text-align: center; font-size: 11px; width: 20%;">Nb Paquets</th>
                            <th style="padding: 5px 10px; border: 1px solid #ccc; text-align: center; font-size: 11px; width: 35%;">Quantite (Tonnes)</th>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ccc; text-align: center; font-weight: bold; font-size: 13px;">
                                <t t-esc="doc.product_id.display_name or ''"/>
                                <t t-if="doc.conditionnement">
                                    <br/>
                                    <span style="font-size: 11px; color: #555;">
                                        <t t-esc="doc.conditionnement or ''"/>
                                    </span>
                                </t>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ccc; text-align: center; font-size: 13px;">
                                <t t-esc="doc.nbr_paquets or 0"/>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ccc; text-align: center; font-weight: bold; font-size: 24px; color: #1a3a5c;">
                                <t t-esc="'%.3f' % doc.quantite_prevue"/>
                                <span style="font-size: 12px; color: #555;"> T</span>
                            </td>
                        </tr>
                    </table>

                    <!-- ROTATION -->
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #999; margin-bottom: 14px;">
                        <tr>
                            <td style="padding: 6px 12px; text-align: center; font-size: 12px;">
                                <b>Rotation N&#176; :</b>
                                <span style="font-size: 18px; font-weight: bold; color: #1a3a5c; margin-left: 8px;">
                                    <t t-esc="doc.numero_rotation or 1"/>
                                </span>
                            </td>
                        </tr>
                    </table>

                    <!-- 3 SIGNATURES -->
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #999; margin-bottom: 10px;">
                        <tr style="background: #1a3a5c;">
                            <th style="padding: 5px; border: 1px solid #999; text-align: center; font-size: 10px; width: 33%; color: white;">
                                Poste de Securite
                            </th>
                            <th style="padding: 5px; border: 1px solid #999; text-align: center; font-size: 10px; width: 33%; color: white;">
                                Poste de Chargement
                            </th>
                            <th style="padding: 5px; border: 1px solid #999; text-align: center; font-size: 10px; width: 33%; color: white;">
                                Bascule
                            </th>
                        </tr>
                        <tr>
                            <td style="height: 60px; border: 1px solid #999; padding: 4px; text-align: center; vertical-align: bottom; font-size: 10px; color: #aaa;">
                                Signature et cachet
                            </td>
                            <td style="height: 60px; border: 1px solid #999; padding: 4px; text-align: center; vertical-align: bottom; font-size: 10px; color: #aaa;">
                                Signature et cachet
                            </td>
                            <td style="height: 60px; border: 1px solid #999; padding: 4px; text-align: center; vertical-align: bottom; font-size: 10px; color: #aaa;">
                                Signature et cachet
                            </td>
                        </tr>
                    </table>

                    <!-- PIED DE PAGE -->
                    <table style="width: 100%; border-collapse: collapse; border-top: 1px solid #ccc;">
                        <tr>
                            <td style="text-align: center; font-size: 8px; color: #777; line-height: 1.6; padding-top: 4px;">
                                <b>SIEGE SOCIAL : OULED ADOUANE BP 01 - AIN EL KEBIRA (W.SETIF) ALGERIE</b><br/>
                                TEL : +(213)36 82 83 39 / +(213)36 82 83 41 — FAX : +(213) 36 82 83 46<br/>
                                SITE WEB : HTTP://WWW.SCAEK.DZ
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <record id="report_bon_circulation" model="ir.actions.report">
        <field name="name">Bon de Circulation</field>
        <field name="model">gica.bon.circulation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_commerciale.report_bon_circulation_template</field>
        <field name="report_file">gestion_commerciale.report_bon_circulation_template</field>
        <field name="binding_model_id" ref="model_gica_bon_circulation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>